#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# plot_loss.py.tmpl — 绘制 loss 曲线并尝试上传公网 (catbox.moe/0x0.st/uguu.se)
# 用法: python plot_loss.py
import os, json, uuid, urllib.request

WS = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOSS_LOG = os.path.join(WS, "outputs", "loss.jsonl")
OUT_PNG = os.path.join(WS, "outputs", "loss_curve.png")


def _post(url, body, boundary, headers_extra=None, ua="Mozilla/5.0"):
    h = {"Content-Type": f"multipart/form-data; boundary={boundary}", "User-Agent": ua}
    if headers_extra:
        h.update(headers_extra)
    req = urllib.request.Request(url, data=body, headers=h)
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read().decode().strip()


def upload(path):
    name = os.path.basename(path)
    with open(path, "rb") as f:
        data = f.read()
    # catbox.moe
    try:
        b = "----lora" + uuid.uuid4().hex
        body = (f"--{b}\r\nContent-Disposition: form-data; name=\"reqtype\"\r\n\r\nfileupload\r\n"
                f"--{b}\r\nContent-Disposition: form-data; name=\"fileToUpload\"; filename=\"{name}\"\r\n"
                f"Content-Type: image/png\r\n\r\n").encode() + data + f"\r\n--{b}--\r\n".encode()
        url = _post("https://catbox.moe/user/api.php", body, b)
        if url.startswith("http"):
            print(f"[upload] catbox.moe OK -> {url}"); return url
    except Exception as e:
        print(f"[upload] catbox.moe failed: {e}")
    # 0x0.st
    try:
        b = "----lora" + uuid.uuid4().hex
        body = (f"--{b}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{name}\"\r\n"
                f"Content-Type: image/png\r\n\r\n").encode() + data + f"\r\n--{b}--\r\n".encode()
        url = _post("https://0x0.st", body, b)
        if url.startswith("http"):
            print(f"[upload] 0x0.st OK -> {url}"); return url
    except Exception as e:
        print(f"[upload] 0x0.st failed: {e}")
    # uguu.se
    try:
        b = "----lora" + uuid.uuid4().hex
        body = (f"--{b}\r\nContent-Disposition: form-data; name=\"files[]\"; filename=\"{name}\"\r\n"
                f"Content-Type: image/png\r\n\r\n").encode() + data + f"\r\n--{b}--\r\n".encode()
        resp = _post("https://uguu.se/upload.php", body, b, headers_extra={"Accept": "application/json"})
        j = json.loads(resp)
        url = j["files"][0]["url"]
        print(f"[upload] uguu.se OK -> {url}"); return url
    except Exception as e:
        print(f"[upload] uguu.se failed: {e}")
    return None


def main():
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    steps, losses, lrs = [], [], []
    with open(LOSS_LOG, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            o = json.loads(line)
            steps.append(o["step"]); losses.append(o["loss"]); lrs.append(o.get("lr", 0))
    fig, ax1 = plt.subplots(figsize=(10, 5.5))
    ax1.plot(steps, losses, "-o", color="#1f77b4", markersize=3, label="Train Loss")
    if len(losses) >= 5:
        w = 5; sm = []
        for i in range(len(losses)):
            lo, hi = max(0, i - w // 2), min(len(losses), i + w // 2 + 1)
            sm.append(sum(losses[lo:hi]) / (hi - lo))
        ax1.plot(steps, sm, "-", color="#ff7f0e", linewidth=2, label=f"Smoothed(w={w})")
    ax1.set_xlabel("Step"); ax1.set_ylabel("Loss")
    ax1.set_title(f"LoRA SFT Loss Curve ({len(steps)} steps)"); ax1.grid(True, alpha=0.3); ax1.legend(loc="upper right")
    ax2 = ax1.twinx(); ax2.plot(steps, lrs, ":", color="#2ca02c", alpha=0.6, label="LR")
    ax2.set_ylabel("Learning Rate"); ax2.legend(loc="center right")
    fig.tight_layout(); fig.savefig(OUT_PNG, dpi=140)
    print(f"[plot] saved {OUT_PNG}")
    url = upload(OUT_PNG)
    with open(os.path.join(WS, "outputs", "loss_curve_url.txt"), "w") as f:
        f.write(url or "")
    if url:
        print(f"[plot] PUBLIC URL: {url}")
    else:
        # 外网不通: 降级表格
        print("[plot] upload failed; 降级表格:")
        print(f"{'step':>5}{'loss':>9}{'lr':>11}")
        for s, l, lr in list(zip(steps, losses, lrs))[::max(1, len(steps)//15)]:
            print(f"{s:>5}{l:>9.4f}{lr:>11.2e}")
        print(f"首5均={sum(losses[:5])/5:.4f} 末5均={sum(losses[-5:])/5:.4f} min={min(losses):.4f}@step{losses.index(min(losses))+1}")


if __name__ == "__main__":
    main()
