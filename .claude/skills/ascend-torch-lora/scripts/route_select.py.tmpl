#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# route_select.py — ascend-torch-lora 自动选路器（纯标准库, 无需 torch）
# 输入: --model-dir --seq-len --steps/--epochs [--data train.jsonl] [--batch]
#       [--ws-dir 工作目录] [--probe 自动2步试训]
# 读取: npu-smi 空闲卡、safetensors 参数量、config 层数/hidden/vocab/MoE
# 输出: 路线(single_card|fsdp2|device_map) + world_size + 显存估算 + 推荐超参 export 块
#       --probe: 实际跑 2 步 → MoE兼容性实测 + 显存公式校准(②) + ETA外推(④) + 遥测账本
# 原则: 精度优先(全路线均为精度安全配置: bf16+GC+eager) → 性能其次(单卡→FSDP2→device_map)
import os, sys, json, math, argparse, re, subprocess, time

# ---------- 模型信息 ----------
def model_info(model_dir):
    """从 safetensors index/config 取 参数量/层数/hidden/inter/vocab/MoE (bf16 假设)"""
    params = None
    idx_p = os.path.join(model_dir, "model.safetensors.index.json")
    if os.path.isfile(idx_p):
        idx = json.load(open(idx_p))
        params = idx.get("metadata", {}).get("total_size", 0) / 2  # bf16
    else:  # 单文件或 model-000xx-of-000yy 命名
        import glob as _g
        tot = 0
        for f in _g.glob(os.path.join(model_dir, "*.safetensors")):
            if "index" in f: continue
            tot += os.path.getsize(f)
        if tot: params = tot / 2
    cfg = json.load(open(os.path.join(model_dir, "config.json")))
    tc = cfg.get("text_config", cfg)  # 多模态取 text_config
    layers = tc.get("num_hidden_layers") or cfg.get("num_hidden_layers") or 32
    hidden = tc.get("hidden_size") or cfg.get("hidden_size") or 4096
    inter = tc.get("intermediate_size") or cfg.get("intermediate_size")
    vocab = cfg.get("vocab_size") or tc.get("vocab_size") or 128000
    # MoE 检测与有效激活中间维度
    n_exp = tc.get("num_experts") or cfg.get("num_experts")
    top_k = tc.get("num_experts_per_tok") or cfg.get("num_experts_per_tok")
    moe_inter = tc.get("moe_intermediate_size") or cfg.get("moe_intermediate_size")
    shared_inter = tc.get("shared_expert_intermediate_size")
    moe = bool(n_exp)
    if moe:
        # 每 token 实际激活: top_k 专家 + (shared_expert 若有); dense fallback 无 inter 时
        eff_inter = (top_k or 8) * (moe_inter or 512) + (shared_inter or 0)
        if inter is None: inter = eff_inter  # 供非 MoE 路径显示
    else:
        eff_inter = inter if inter else int(hidden * 4)
    return dict(params=params, layers=layers, hidden=hidden, inter=inter or int(hidden * 4),
                eff_inter=eff_inter, vocab=vocab, moe=moe, n_experts=n_exp, top_k=top_k,
                moe_inter=moe_inter, shared_inter=shared_inter)

# ---------- NPU 空闲卡 ----------
def free_cards(used_ratio=0.20):
    """解析 npu-smi info, 返回 [(idx, used_mb, total_mb)] 中 used_ratio 以下的卡"""
    try:
        out = subprocess.run(["npu-smi", "info"], capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return []
    cards = []
    for line in out.splitlines():
        ms = re.findall(r"(\d+)\s*/\s*(\d+)", line)
        if not ms: continue
        used, total = map(int, ms[-1])  # 行末最后一对 = HBM-Usage
        if total > 1000:  # MB 量级才算 die 行
            cards.append((used, total))
    return [(i, u, t) for i, (u, t) in enumerate(cards) if u / t <= used_ratio]

# ---------- 显存估算 (GB, bf16 + grad-ckpt, MoE 感知) ----------
def est_mem(mi, seq, batch, world, route):
    """返回每卡显存估算 (GB)。MoE: 权重按总参数(所有专家驻留), 激活按 top-k 有效中间维"""
    P = mi["params"]; L = mi["layers"]; H = mi["hidden"]; EI = mi["eff_inter"]; V = mi["vocab"]
    W = P * 2 / 1e9                                # 权重 bf16 (MoE=全专家)
    opt = P * 0.008 * 12 / 1e9                     # LoRA AdamW fp32 状态(可训练~0.8%)
    # 激活 (grad-ckpt 生效): 各层 checkpoint 输入 + 单层重算峰值 + logits/CE
    act = (L * seq * H * 2 + seq * (4 * H + 2 * EI) * 2 + seq * V * 10) * batch / 1e9
    act *= 1.5  # 工作缓冲安全系数
    if route == "single":
        return W + opt + act, W, opt, act
    if route == "fsdp2":   # 数据并行: 激活不分片(每卡过全模型); 权重分片; +单层all-gather瞬态
        return W / world + opt + act + W / L * 1.5, W / world, opt, act
    # device_map 流水线: 权重与激活都按卡分摊
    return (W + act) / world + opt, W / world, opt, act / world

# ---------- 超参自动选择 ----------
def pick_hparams(params, steps, batch, world, n_samples=None, epochs=None):
    P = params or 1e9
    lr = 2e-4 if P < 1e9 else (1e-4 if P <= 3e10 else 5e-5)
    lora_r = 16; lora_alpha = 32; dropout = 0.05
    if steps is None and epochs and n_samples:
        eff = max(1, batch * world)
        steps = math.ceil(epochs * n_samples / eff)
    steps = steps or 150
    warmup = max(10, math.ceil(0.1 * steps))
    grad_accum = max(1, math.ceil(8 / (batch * world)))
    return dict(lr=lr, lora_r=lora_r, lora_alpha=lora_alpha, dropout=dropout,
                warmup=warmup, grad_accum=grad_accum, steps=steps)

# ---------- probe: 自动 2 步试训 ----------
def run_probe(route, world, devs, mi, args, hp, pred_mem):
    """跑 2 步试训: MoE兼容(①) + 显存校准(②) + ETA外推(④)。返回解析 dict 或 None"""
    ws = args.ws_dir
    py = os.path.join(ws, ".venv", "bin", "python")
    if not os.path.isfile(py): py = sys.executable
    probe_ws = os.path.join(ws, "probe_run"); os.makedirs(probe_ws, exist_ok=True)
    env = dict(os.environ)
    env.update({
        "MODEL_DIR": args.model_dir, "DATA_FILE": args.data or "",
        "NUM_STEPS": "2", "LR": str(hp["lr"]), "LORA_R": str(hp["lora_r"]),
        "LORA_ALPHA": str(hp["lora_alpha"]), "WARMUP": "2", "MAX_LEN": str(args.seq_len),
        "BATCH_SIZE": str(args.batch),
        "WS_DIR": probe_ws, "OUT_DIR": os.path.join(probe_ws, "outputs"),
        "ASCEND_RT_VISIBLE_DEVICES": devs,
        "TORCH_DEVICE_BACKEND_AUTOLOAD": "0", "TASK_QUEUE_ENABLE": "1",
        "HF_ENDPOINT": "https://hf-mirror.com", "TOKENIZERS_PARALLELISM": "false",
    })
    os.makedirs(env["OUT_DIR"], exist_ok=True)
    if route == "fsdp2":
        cmd = [py, "-m", "torch.distributed.run", "--nproc_per_node=%d" % world,
               "--master_port=29711", os.path.join(ws, "scripts", "lora_train_fsdp.py")]
    else:
        cmd = [py, os.path.join(ws, "scripts", "lora_train.py")]
        if route == "device_map":
            hbm = 64
            mm = " ".join(f"{i}:{hbm*0.9:.0f}GiB" for i in devs.split(","))
            env["DEVICE_MAP"] = "auto"; env["MAX_MEMORY"] = mm; env["GRADIENT_CHECKPOINTING"] = "1"
        env["GRAD_ACCUM"] = str(hp["grad_accum"])
    print(f"\n[probe] 启动 2 步试训 ({route}, {world}卡) ...", flush=True)
    t0 = time.time()
    try:
        r = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=3600)
        out = r.stdout + r.stderr
    except subprocess.TimeoutExpired:
        print("[probe] FATAL: 试训超时(60min)"); return None
    tail = [l for l in out.splitlines() if any(k in l for k in
             ["[probe]", "[train] step", "[fsdp]", "[lora] trainable", "[data] built",
              "OutOfMemory", "Error", "RuntimeError", "Traceback"])]
    for l in tail[-12:]: print("  " + l[:160], flush=True)
    m = re.search(r"\[probe\] s_per_step=([\d.]+) s_per_step_avg=([\d.]+) mem_peak_gb=([\d.]+) last_loss=([\d.-]+)", out)
    if not m:  # 兼容旧格式(无 avg)
        m = re.search(r"\[probe\] s_per_step=([\d.]+) mem_peak_gb=([\d.]+) last_loss=([\d.-]+)", out)
        if m: m = type("M", (), {"groups": lambda self: (m.group(1), m.group(1), m.group(2), m.group(3))})()
    if not m:
        print("[probe] FATAL: 未能解析 [probe] 行(试训未完成)——详见上方错误"); return None
    sps, sps_avg, mem, loss = float(m.group(1)), float(m.group(2)), float(m.group(3)), float(m.group(4))
    ok_loss = math.isfinite(loss) and 0 < loss < 20
    eta_s = sps * hp["steps"]
    print(f"\n[probe] ===== 试训结果 =====")
    print(f"  兼容性(含MoE): ✅ 2步跑通, last_loss={loss} ({'合理' if ok_loss else '异常!需检查'})")
    print(f"  显存校准: 实测峰值 {mem:.1f}GB/rank vs 公式预测 {pred_mem:.1f}GB "
          f"(偏差 {(mem-pred_mem)/max(pred_mem,0.1)*100:+.0f}%, {'公式偏保守✓' if mem<=pred_mem else '⚠️公式低估,需上调系数'})")
    print(f"  吞吐/ETA: 稳态 {sps:.2f}s/step (含首步编译平均 {sps_avg:.2f}) → {hp['steps']}步预计 {eta_s/60:.0f} 分钟")
    rec = {"ts": time.strftime("%F %T"), "model": os.path.basename(args.model_dir),
           "params_b": round((mi['params'] or 0)/1e9, 2), "moe": mi["moe"],
           "route": route, "world": world, "seq": args.seq_len, "batch": args.batch,
           "pred_mem_gb": round(pred_mem, 2), "act_mem_gb": mem, "s_per_step": sps,
           "s_per_step_avg": sps_avg,
           "steps": hp["steps"], "eta_min": round(eta_s/60, 1), "last_loss": loss}
    led = os.path.join(ws, "outputs", "route_calibration.jsonl")
    os.makedirs(os.path.dirname(led), exist_ok=True)
    with open(led, "a") as f: f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print(f"  遥测已记录 → {led}")
    return rec

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--model-dir", required=True)
    ap.add_argument("--seq-len", type=int, default=2048)
    ap.add_argument("--batch", type=int, default=1)
    ap.add_argument("--steps", type=int, default=None)
    ap.add_argument("--epochs", type=float, default=None)
    ap.add_argument("--data", default=None, help="train.jsonl (数样本数算 steps; probe 必填)")
    ap.add_argument("--trainable-ratio", type=float, default=0.008)
    ap.add_argument("--max-cards", type=int, default=None, help="限制最大用卡数; 默认用满空闲卡")
    ap.add_argument("--scale-up", action="store_true", help="小模型也用多卡数据并行扩吞吐")
    ap.add_argument("--probe", action="store_true", help="自动 2 步试训: MoE兼容+显存校准+ETA")
    ap.add_argument("--ws-dir", default=".", help="工作目录(含 scripts/ 与 .venv; probe 用)")
    args = ap.parse_args()

    mi = model_info(args.model_dir)
    cards = free_cards()
    n_free = len(cards)
    if args.max_cards: n_free = min(n_free, args.max_cards)
    n_samples = None
    if args.data and os.path.isfile(args.data):
        with open(args.data) as f: n_samples = sum(1 for _ in f)
    if not mi["params"]:
        print("[route] FATAL: 读不到模型参数量(safetensors)"); sys.exit(1)
    if n_free == 0:
        print("[route] FATAL: npu-smi 无空闲卡(阈值 used<20%)"); sys.exit(1)
    hbm_gb = cards[0][2] / 1024
    usable = 0.85 * hbm_gb

    print(f"[model] params={mi['params']/1e9:.2f}B layers={mi['layers']} hidden={mi['hidden']} "
          f"vocab={mi['vocab']}", end="")
    if mi["moe"]:
        print(f" [MoE: {mi['n_experts']}专家 top-{mi['top_k']}, 有效中间维={mi['eff_inter']}]")
    else:
        print()
    print(f"[npu]   空闲卡 {n_free} 张 (HBM {hbm_gb:.0f}GB/卡, 可用预算 {usable:.1f}GB/卡)")

    route = world = None
    m1 = est_mem(mi, args.seq_len, args.batch, 1, "single")
    if m1[0] <= usable and not args.scale_up:
        route, world = "single_card", 1
        print(f"[route] ① 单卡可行: 总显存 {m1[0]:.1f}GB ≤ {usable:.1f}GB → **single_card**(无通信, 最快)")
        if n_free >= 2:
            print(f"[route]    (大数据集要扩吞吐可加 --scale-up: FSDP2 用满 {n_free} 卡数据并行)")
    else:
        mn = est_mem(mi, args.seq_len, args.batch, n_free, "fsdp2")
        if mn[0] <= usable:
            route, world = "fsdp2", n_free
            why = "单卡放不下" if m1[0] > usable else "--scale-up 吞吐扩展"
            print(f"[route] ② FSDP2 {n_free} 卡({why}): shard {mn[1]:.1f}GB + 激活 {mn[3]:.1f}GB + opt = "
                  f"{mn[0]:.1f}GB ≤ {usable:.1f}GB → **fsdp2**(数据并行吞吐最优, HCCS 实测 device_map 的 2.2-4.7×/样本)")
        else:
            for n in range(2, n_free + 1):
                mnd = est_mem(mi, args.seq_len, args.batch, n, "device_map")
                if mnd[0] <= usable:
                    route, world = "device_map", n
                    print(f"[route] ③ device_map {n} 卡: (权重+激活)/{n} + opt = {mnd[0]:.1f}GB ≤ {usable:.1f}GB "
                          f"→ **device_map**(激活也分摊, 大 seq 兜底)")
                    break
    if route is None:
        print(f"[route] FATAL: {n_free} 卡都放不下。建议: 减 seq_len / 用满全部卡 / 升级 >{hbm_gb:.0f}GB HBM 卡"); sys.exit(1)

    hp = pick_hparams(mi["params"], args.steps, args.batch, world, n_samples, args.epochs)
    devs = ",".join(str(c[0]) for c in cards[:world])
    print(f"\n[hyper] 自动超参 (模型 {mi['params']/1e9:.1f}B{' MoE' if mi['moe'] else ''}): LR={hp['lr']} "
          f"(<1B→2e-4, 1-30B→1e-4, >30B→5e-5), lora_r={hp['lora_r']}, alpha={hp['lora_alpha']}, "
          f"warmup={hp['warmup']}(10%步数), grad_accum={hp['grad_accum']}(凑有效batch≈8), steps={hp['steps']}")
    if mi["moe"]:
        print("[note]  MoE(实测): 融合实现的 256 路由专家不是 nn.Linear, peft 挂不上——LoRA 只覆盖 注意力+共享专家;"
              " 训练有效(loss 正常下降)但路由专家不被适配; --probe 实测验证")
    print("\n===== 复制以下环境变量启动训练 =====")
    if route == "single_card":
        print(f"export MODEL_DIR={args.model_dir}")
        print(f"export NUM_STEPS={hp['steps']} LR={hp['lr']} LORA_R={hp['lora_r']} LORA_ALPHA={hp['lora_alpha']} "
              f"WARMUP={hp['warmup']} GRAD_ACCUM={hp['grad_accum']} MAX_LEN={args.seq_len} BATCH_SIZE={args.batch}")
        print(f"export ASCEND_RT_VISIBLE_DEVICES={cards[0][0]}   # 单卡(融合优化器 NpuFusedAdamW)")
        print("# 启动: python scripts/lora_train.py")
    elif route == "fsdp2":
        print(f"export MODEL_DIR={args.model_dir}")
        print(f"export NUM_STEPS={hp['steps']} LR={hp['lr']} LORA_R={hp['lora_r']} LORA_ALPHA={hp['lora_alpha']} "
              f"WARMUP={hp['warmup']} MAX_LEN={args.seq_len} BATCH_SIZE={args.batch}")
        print(f"export ASCEND_RT_VISIBLE_DEVICES={devs}")
        print("# 启动: python -m torch.distributed.run --nproc_per_node=%d scripts/lora_train_fsdp.py" % world)
    else:
        print(f"export MODEL_DIR={args.model_dir}")
        print(f"export NUM_STEPS={hp['steps']} LR={hp['lr']} LORA_R={hp['lora_r']} LORA_ALPHA={hp['lora_alpha']} "
              f"WARMUP={hp['warmup']} GRAD_ACCUM={hp['grad_accum']} MAX_LEN={args.seq_len} BATCH_SIZE={args.batch}")
        print(f"export ASCEND_RT_VISIBLE_DEVICES={devs}")
        hbm0 = cards[0][2] / 1024
        mm = " ".join(f"{i}:{hbm0*0.9:.0f}GiB" for i in [c[0] for c in cards[:world]])
        print(f'export DEVICE_MAP=auto MAX_MEMORY="{mm}" GRADIENT_CHECKPOINTING=1')
        print("# 启动: python scripts/lora_train.py")
    print("# 精度门(训练前后必过): ①标签自检 n_label>0 且无 user 泄漏 ②eager 基线 ③训练后 base vs LoRA 验证")

    if args.probe:
        if not (args.data and os.path.isfile(args.data)):
            print("\n[probe] FATAL: --probe 需要 --data train.jsonl"); sys.exit(1)
        if not os.path.isfile(os.path.join(args.ws_dir, "scripts", "lora_train.py")):
            print(f"\n[probe] FATAL: {args.ws_dir}/scripts/ 下无 lora_train.py (先把 skill 模板复制到 ws)"); sys.exit(1)
        pred = est_mem(mi, args.seq_len, args.batch, world, route)[0]
        rec = run_probe(route, world, devs, mi, args, hp, pred)
        if rec is None: sys.exit(1)

if __name__ == "__main__":
    main()
