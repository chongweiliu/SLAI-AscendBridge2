#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""lora_train_task.py.tmpl — 非 CausalLM 五范式 LoRA 训练器（encoder/encoder-decoder，2026-09-10 五模型实战验证）

适用：embed(双塔嵌入)/seq2seq(翻译)/rerank(重排)/cls(分类)/ner(实体识别) —— 详见
  references/non-causal-lm-paradigms.md（数据格式/loss/验证指标/超参模式/两类「无提升」正确结论）。

用法（环境变量）:
  PARADIGM=embed|seq2seq|rerank|cls|ner   # 必填
  MODEL_DIR=... DATA_FILE=... OUT_DIR=... # 必填
  NUM_STEPS=200 LR=1e-4 LORA_R=16 LORA_ALPHA=32 WARMUP=20
  BATCH(默认 embed16/seq2seq8/rerank8/cls16/ner16) MAX_LEN(默认 256/256/512/512/256)

已规避的坑（见 pitfalls）:
  #35 seq2seq 必须 tok.src_lang + tok.tgt_lang 都设（text_target 的语言码头）
  #34 训练器自检打印前 N 条标签分布（暴露 probe 偏斜）
  #5  NpuFusedAdamW zero_grad(set_to_none=False)
  NPU 骨架与 lora_train.py.tmpl 一致（autoload=0 手动 import、bf16 autocast、cosine+warmup）
配套（实战副本，按需复制到工作区）: lora-ws/.cat2/{make_split2.py, sweep2.py, val_loss_task.py, validate_task.py}
"""

import json
import math
import os
import random
import time

os.environ.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD", "0")
os.environ.setdefault("TASK_QUEUE_ENABLE", "1")
os.environ.setdefault("PYTORCH_NPU_ALLOC_CONF", "expandable_segments:True")
os.environ.setdefault("HF_ENDPOINT", "https://hf-mirror.com")
os.environ.setdefault("TOKENIZERS_PARALLELISM", "false")

import torch  # noqa: E402
import torch_npu  # noqa: E402,F401
from torch_npu.optim import NpuFusedAdamW  # noqa: E402
import transformers  # noqa: E402
from transformers import AutoTokenizer  # noqa: E402
from peft import LoraConfig, get_peft_model  # noqa: E402

PARADIGM = os.environ["PARADIGM"]
MODEL_DIR = os.environ["MODEL_DIR"]
WS = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.environ.get("DATA_FILE", os.path.join(WS, "outputs", "train.jsonl"))
OUT_DIR = os.environ.get("OUT_DIR", os.path.join(WS, "outputs"))
NUM_STEPS = int(os.environ.get("NUM_STEPS", "200"))
LR = float(os.environ.get("LR", "1e-4"))
WARMUP = int(os.environ.get("WARMUP", "20"))
LORA_R = int(os.environ.get("LORA_R", "16"))
LORA_ALPHA = int(os.environ.get("LORA_ALPHA", "32"))
LORA_DROPOUT = float(os.environ.get("LORA_DROPOUT", "0.05"))
DEF_BATCH = {"embed": 16, "seq2seq": 8, "rerank": 8, "cls": 16, "ner": 16}[PARADIGM]
BATCH = int(os.environ.get("BATCH", str(DEF_BATCH)))
MAX_LEN = int(os.environ.get("MAX_LEN", {"embed": 256, "seq2seq": 256, "rerank": 512, "cls": 512, "ner": 256}[PARADIGM]))
SEED = int(os.environ.get("SEED", "42"))
DEV = os.environ.get("NPU_DEV", "npu:0")

CANDIDATES = ["q_proj", "k_proj", "v_proj", "out_proj", "fc1", "fc2",
              "query", "key", "value", "dense",
              "q_lin", "k_lin", "v_lin", "out_lin", "lin1", "lin2"]


def lr_at(step, num_steps, warmup, lr):
    if step < warmup:
        return lr * (step + 1) / warmup
    prog = (step - warmup) / max(1, num_steps - warmup)
    return lr * 0.5 * (1 + math.cos(math.pi * min(1.0, prog)))


def load_model():
    from transformers import AutoModel, AutoModelForSeq2SeqLM, AutoModelForSequenceClassification, AutoModelForTokenClassification
    loader = {"embed": AutoModel, "seq2seq": AutoModelForSeq2SeqLM,
              "rerank": AutoModelForSequenceClassification, "cls": AutoModelForSequenceClassification,
              "ner": AutoModelForTokenClassification}[PARADIGM]
    kw = dict(dtype=torch.bfloat16, trust_remote_code=True, attn_implementation="eager")
    return loader.from_pretrained(MODEL_DIR, **kw)


def tok_batch(tok, texts):
    return tok(texts, padding=True, truncation=True, max_length=MAX_LEN, return_tensors="pt")


def main():
    t0 = time.time()
    torch.manual_seed(SEED); random.seed(SEED)
    os.makedirs(OUT_DIR, exist_ok=True)
    ad_dir = os.path.join(OUT_DIR, "lora_adapter")
    os.makedirs(ad_dir, exist_ok=True)
    print(f"[env] torch={torch.__version__} transformers={transformers.__version__} paradigm={PARADIGM}", flush=True)
    torch.npu.set_device(DEV)
    print(f"[env] npu={torch.npu.is_available()} dev={DEV}", flush=True)

    tok = AutoTokenizer.from_pretrained(MODEL_DIR, trust_remote_code=True)
    if PARADIGM == "seq2seq":
        tok.src_lang = "eng_Latn"   # M2M100: 源语言
        tok.tgt_lang = "zho_Hans"   # 目标语言：text_target 编码带 zho_Hans 头（与生成 forced_bos 一致）
        GLOBAL_ZH_BOS = tok.convert_tokens_to_ids("zho_Hans")
        print(f"[tok] src=eng_Latn tgt=zho_Hans bos={GLOBAL_ZH_BOS}", flush=True)

    model = load_model().to(DEV)
    model.config.use_cache = False if hasattr(model.config, "use_cache") else False
    print(f"[model] loaded {time.time()-t0:.1f}s params={sum(p.numel() for p in model.parameters())/1e6:.1f}M", flush=True)

    # LoRA 目标自动发现（跨 5 架构）
    linear_names = {n.split(".")[-1] for n, m in model.named_modules() if type(m).__name__ == "Linear"}
    targets = sorted(set(CANDIDATES) & linear_names)
    print(f"[lora] linear 末名: {sorted(linear_names)}", flush=True)
    print(f"[lora] target_modules={targets}", flush=True)
    assert targets, "未发现 LoRA 目标模块"
    model = get_peft_model(model, LoraConfig(r=LORA_R, lora_alpha=LORA_ALPHA, lora_dropout=LORA_DROPOUT,
                                             target_modules=targets, bias="none"))
    model.print_trainable_parameters()
    trainable = [p for p in model.parameters() if p.requires_grad]
    model.train()

    # ---- 数据 ----
    recs = [json.loads(l) for l in open(DATA, encoding="utf-8") if l.strip()]
    print(f"[data] {len(recs)} records from {DATA}", flush=True)
    # 精度门①: 范式自检
    if PARADIGM == "cls":
        labels = [r["label"] for r in recs]
        assert set(labels) <= {0, 1}, f"cls 标签越界: {set(labels)}"
        print(f"[check] cls 标签分布: { {v: labels.count(v) for v in set(labels)} }", flush=True)
    if PARADIGM == "ner":
        from transformers import AutoConfig
        id2label = AutoConfig.from_pretrained(MODEL_DIR).id2label
        label2id = {v: int(k) for k, v in id2label.items()}
        all_tags = {t for r in recs for t in r["tags"]}
        bad = all_tags - set(label2id)
        assert not bad, f"ner 标签不在模型 label 空间: {bad}"
        print(f"[check] ner 标签集 ✓ ({len(all_tags)} 种)，label2id: {label2id}", flush=True)
    if PARADIGM == "embed":
        assert all(r.get("anchor") and r.get("positive") and r.get("negative") for r in recs[:50]), "embed 三元组缺失"
        print("[check] embed 三元组完整性 ✓", flush=True)
    if PARADIGM == "rerank":
        assert all(r.get("query") and r.get("positive") and r.get("negative") for r in recs[:50]), "rerank 三元组缺失"
        print("[check] rerank 三元组完整性 ✓", flush=True)
    if PARADIGM == "seq2seq":
        assert all(r.get("en") and r.get("zh") for r in recs[:50]), "seq2seq 平行对缺失"
        print("[check] seq2seq 平行对完整性 ✓", flush=True)

    # ---- 范式 loss ----
    def forward_loss(batch_recs):
        with torch.autocast("npu", dtype=torch.bfloat16):
            if PARADIGM == "embed":
                texts = []
                for r in batch_recs:
                    texts += [r["anchor"], r["positive"], r["negative"]]
                enc = tok_batch(tok, texts)
                out = model(input_ids=enc["input_ids"].to(DEV), attention_mask=enc["attention_mask"].to(DEV))
                h = out.last_hidden_state[:, 0]  # CLS
                h = torch.nn.functional.normalize(h.float(), dim=-1)
                B = len(batch_recs)
                a, pos, neg = h[0::3], h[1::3], h[2::3]
                sims = a @ torch.cat([pos, neg], 0).T * 20.0  # in-batch InfoNCE
                tgt = torch.arange(B, device=DEV)
                return torch.nn.functional.cross_entropy(sims, tgt)
            if PARADIGM == "rerank":
                pairs = []
                for r in batch_recs:
                    pairs += [(r["query"], r["positive"]), (r["query"], r["negative"])]
                enc = tok([p[0] for p in pairs], text_pair=[p[1] for p in pairs],
                          padding=True, truncation=True, max_length=MAX_LEN, return_tensors="pt")
                out = model(input_ids=enc["input_ids"].to(DEV), attention_mask=enc["attention_mask"].to(DEV))
                s = out.logits.float().squeeze(-1)
                B = len(batch_recs)
                s_pos, s_neg = s[0::2], s[1::2]
                return torch.nn.functional.softplus(-(s_pos - s_neg)).mean()
            if PARADIGM == "seq2seq":
                src = tok([r["en"] for r in batch_recs], padding=True, truncation=True,
                          max_length=MAX_LEN, return_tensors="pt")
                lab = tok(text_target=[r["zh"] for r in batch_recs], padding=True, truncation=True,
                          max_length=MAX_LEN, return_tensors="pt").input_ids
                lab[lab == tok.pad_token_id] = -100
                out = model(input_ids=src["input_ids"].to(DEV), attention_mask=src["attention_mask"].to(DEV),
                            labels=lab.to(DEV))
                return out.loss
            if PARADIGM == "cls":
                enc = tok_batch(tok, [r["text"] for r in batch_recs])
                out = model(input_ids=enc["input_ids"].to(DEV), attention_mask=enc["attention_mask"].to(DEV),
                            labels=torch.tensor([r["label"] for r in batch_recs], device=DEV))
                return out.loss
            if PARADIGM == "ner":
                enc = tok([r["tokens"] for r in batch_recs], is_split_into_words=True, padding=True,
                          truncation=True, max_length=MAX_LEN, return_tensors="pt")
                lab = torch.full(enc["input_ids"].shape, -100, dtype=torch.long)
                for bi, r in enumerate(batch_recs):
                    wids = enc.word_ids(batch_index=bi)
                    prev = None
                    for ti, w in enumerate(wids):
                        if w is None or w == prev:
                            continue
                        lab[bi, ti] = label2id[r["tags"][w]]
                        prev = w
                out = model(input_ids=enc["input_ids"].to(DEV), attention_mask=enc["attention_mask"].to(DEV),
                            labels=lab.to(DEV))
                return out.loss
        raise ValueError(PARADIGM)

    opt = NpuFusedAdamW(trainable, lr=LR, betas=(0.9, 0.95), weight_decay=0.01, eps=1e-8)
    rng = random.Random(SEED)
    n = len(recs)
    opt.zero_grad(set_to_none=False)
    print(f"[train] {NUM_STEPS} steps, batch={BATCH}, lr={LR}, r={LORA_R}, warmup={WARMUP}, max_len={MAX_LEN}", flush=True)
    t_tr = time.time()
    log = []
    for step in range(NUM_STEPS):
        batch = [recs[rng.randint(0, n - 1)] for _ in range(BATCH)]
        loss = forward_loss(batch)
        loss.backward()
        cur_lr = lr_at(step, NUM_STEPS, WARMUP, LR)
        for g in opt.param_groups:
            g["lr"] = cur_lr
        torch.nn.utils.clip_grad_norm_(trainable, 1.0)
        opt.step()
        opt.zero_grad(set_to_none=False)
        rec = {"step": step + 1, "loss": round(loss.item(), 6), "lr": round(cur_lr, 8),
               "elapsed_s": round(time.time() - t_tr, 2)}
        log.append(rec)
        with open(os.path.join(OUT_DIR, "loss.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        if (step + 1) % 10 == 0 or step == 0:
            print(f"[train] step {step+1}/{NUM_STEPS} loss={rec['loss']:.4f} elapsed={rec['elapsed_s']:.1f}s", flush=True)

    total = time.time() - t_tr
    steady = (log[-1]["elapsed_s"] - log[-2]["elapsed_s"]) if len(log) >= 2 else total / NUM_STEPS
    print(f"[probe] s_per_step={steady:.2f} mem_peak_gb={torch.npu.max_memory_allocated()/2**30:.2f} last_loss={log[-1]['loss']}", flush=True)
    print(f"[train] done {NUM_STEPS} steps in {total:.1f}s ({total/NUM_STEPS:.2f}s/step)", flush=True)
    model.save_pretrained(ad_dir)
    tok.save_pretrained(ad_dir)
    with open(os.path.join(OUT_DIR, "loss_raw.json"), "w", encoding="utf-8") as f:
        json.dump({"steps": log, "num_steps": NUM_STEPS, "total_train_s": round(total, 2),
                   "config": {"paradigm": PARADIGM, "model": MODEL_DIR, "lora_r": LORA_R, "lora_alpha": LORA_ALPHA,
                              "lr": LR, "batch": BATCH, "max_len": MAX_LEN, "warmup": WARMUP, "n_records": n}}, f, indent=2)
    print(f"[save] adapter -> {ad_dir}; [done] {time.time()-t0:.1f}s", flush=True)


if __name__ == "__main__":
    main()
