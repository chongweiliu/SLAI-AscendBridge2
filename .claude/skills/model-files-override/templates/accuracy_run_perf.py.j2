    if conll_path.exists():
        print(f"[benchmark] loading dataset from {conll_path}")
        ds = load_from_disk(str(conll_path))
        if hasattr(ds, "keys") and ("validation" in ds or "test" in ds):
            split = "validation" if "validation" in ds else "test"
            ds = ds[split]
        # conll2003: tokens 为 list of lists，ner_tags 为 list of lists
        texts = []
