{%- elif model_type == "asr" %}
def load_benchmark_audio() -> tuple[list[np.ndarray], str]:
    """加载测试音频数据集，返回 (audio_arrays, dataset_name)。

    优先级:
    1. librispeech (模糊匹配音频文件，使用 librosa 加载)
    2. 降级到生成随机音频

    注意: datasets 库的 Arrow 格式音频需要 torchcodec 解码，
    但 torchcodec 不支持 aarch64 架构，所以这里使用 librosa 从文件加载。
    """
    import glob as _glob
    import librosa

    # 尝试加载 librispeech（模糊匹配音频文件）
    libri_patterns = [
        str(DATASET_DIR / "*librispeech*") + "/**/*.flac",
        str(DATASET_DIR / "*librispeech*") + "/**/*.wav",
    ]
    audio_files = []
    for pattern in libri_patterns:
        audio_files.extend(_glob.glob(pattern, recursive=True))
    audio_files = sorted(audio_files)  # 确保顺序一致

    if audio_files:
        print(f"[benchmark] found {len(audio_files)} audio files in librispeech")
        audio_arrays = []
        for f in audio_files[:500]:  # 最多加载 500 个文件
            audio, sr = librosa.load(f, sr=16000, mono=True)
            audio_arrays.append(audio)
        print(f"[benchmark] loaded {len(audio_arrays)} audio samples from librispeech")
        return audio_arrays, "librispeech"

    # 降级到生成随机音频
    print("[benchmark] using generated random audio")
    np.random.seed(42)
    audio_arrays = [np.random.randn(16000).astype(np.float32) for _ in range(250)]  # 1s audio at 16kHz
    return audio_arrays, "random"


