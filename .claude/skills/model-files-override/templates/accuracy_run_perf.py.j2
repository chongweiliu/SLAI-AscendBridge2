def run_step2(model, tokenizer, first_device, device_short, mode_str, adapt_dir: Path, dataset_name: str, texts: list[str], max_samples: int = 250):
    """Step 2: 全样本推理 -> outputs_*.pt (BERT, 非生成式)

    BERT 模型不测量 TTFT/TPOT，返回 None。

    内存优化：
    - 每个样本处理完后立即移动到 CPU
    - 每 32 个样本清理 NPU/CUDA 缓存
    - 默认限制样本数为 250（避免产出文件过大）

    输出格式：
    - BERT: [CLS] token 向量 (1, hidden_dim)

    Returns:
        tuple: (outputs_path, ttft_avg, tpot_avg) - BERT 模型 ttft_avg=None, tpot_avg=None
    """
    print("\n" + "=" * 60)
    print("Step 2: 全样本推理 (精度测试)")
    print("=" * 60)

    model_dtype = next(model.parameters()).dtype
    dtype_str = get_dtype_str(model_dtype)

    outputs_path = adapt_dir / f"outputs_{device_short}_{dtype_str}_{mode_str}_{dataset_name}{PERF_SUFFIX}.pt"

    # 限制样本数（R1 规则：最多 250 个样本）
    texts = texts[:max_samples]
    print(f"[benchmark] {len(texts)} samples to process (max {max_samples})")

    all_outputs = []
    with torch.no_grad():
        for i, text in enumerate(texts):
            inputs = tokenizer(text, return_tensors="pt", truncation=True, max_length=512).to(first_device)
            # BERT: 提取 [CLS] token 向量
            out = model(**inputs)
            hidden_state = out.last_hidden_state  # [1, seq_len, hidden_dim]
            cls_embedding = hidden_state[:, 0, :].cpu()  # [1, hidden_dim]
            all_outputs.append(cls_embedding)
            del out, hidden_state
            del inputs

            # 每 32 个样本清理缓存（更频繁以避免 OOM）
            if (i + 1) % 32 == 0:
                if device_short == "npu":
                    torch.npu.empty_cache()
                elif device_short == "cuda":
                    torch.cuda.empty_cache()
                print(f"[benchmark] processed {i + 1}/{len(texts)} samples (cache cleared)")

            elif (i + 1) % 8 == 0:
                print(f"[benchmark] processed {i + 1}/{len(texts)} samples")

    # 保存 outputs
    torch.save(all_outputs, outputs_path)

    print(f"[benchmark] outputs saved to {outputs_path}")
    print(f"[benchmark] total samples: {len(texts)}")

    return outputs_path, None, None  # BERT 不测量 TTFT/TPOT


