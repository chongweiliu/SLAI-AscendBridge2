def run_compare(baseline_pt: str | Path, perf_pt: str | Path) -> dict:
    """对比优化前/后 NPU 产出，复用 benchmark_tool.compare_outputs。"""
    project_root = Path(__file__).resolve().parent.parent.parent
    if str(project_root) not in sys.path:
        sys.path.insert(0, str(project_root))
    from benchmark.scripts.benchmark_tool import compare_outputs

    return compare_outputs(str(baseline_pt), str(perf_pt))


def find_baseline_perf_pairs(adapt_dir: Path) -> list[tuple[Path, Path]]:
    """查找 (baseline, perf) 产出对。兼容 npu/npu_0、cuda/cuda_0。"""
    pairs = []
    for perf_file in adapt_dir.glob("outputs_*_perf.pt"):
        if baseline_path := _first_existing(_baseline_output_candidates(adapt_dir, perf_file.name)):
            pairs.append((baseline_path, perf_file))
    return pairs


def cmd_compare(args) -> None:
    """compare 子命令：对比优化前（accuracy_run.py）与优化后（accuracy_run_perf.py）的 NPU 产出。"""
    adapt_dir = Path(__file__).resolve().parent

    if bool(args.baseline_pt) != bool(args.perf_pt):
        print("✗ compare 需同时指定 baseline.pt 和 perf.pt，或都不指定以自动查找")
        sys.exit(1)

    if args.baseline_pt and args.perf_pt:
        baseline_path = Path(args.baseline_pt)
        perf_path = Path(args.perf_pt)
        if not baseline_path.exists():
            print(f"✗ File not found: {baseline_path}")
            sys.exit(1)
        if not perf_path.exists():
            print(f"✗ File not found: {perf_path}")
            sys.exit(1)
        result = run_compare(baseline_path, perf_path)
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return

    pairs = find_baseline_perf_pairs(adapt_dir)
    if not pairs:
        print("⚠ No baseline/perf pairs found")
        print("  Need: accuracy_run.py outputs (e.g. outputs_npu_fp32_config_wikitext.pt)")
        print("  and:  accuracy_run_perf.py outputs (e.g. outputs_npu_fp32_config_wikitext_perf.pt)")
        print("  Or:   compare <baseline.pt> <perf.pt>")
        sys.exit(1)

    for baseline_pt, perf_pt in pairs:
        print(f"\n--- 优化前 {baseline_pt.name} vs 优化后 {perf_pt.name} ---")
        try:
            result = run_compare(baseline_pt, perf_pt)
            print(json.dumps(result, indent=2, ensure_ascii=False))
        except Exception as e:
            print(f"✗ Error: {e}")


def main():
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="cmd", help="run | compare")

    # run 子命令（默认）
    run_parser = subparsers.add_parser("run", help="run benchmark (default)")
    run_parser.add_argument("--use-pretrained", action="store_true", help="Tier2: load pretrained weights")
    run_parser.add_argument("--max-samples", type=int, default=250, help="Max samples to process (default 250, per R1 rule)")
    run_parser.add_argument("--cpu", action="store_true", help="Force CPU inference (disable NPU/CUDA)")

    # compare 子命令：对比优化前(baseline)与优化后(perf)的 NPU 产出。精度对比必须使用 pretrained 权重，baseline 与 perf 均需 --use-pretrained
    cmp_parser = subparsers.add_parser("compare", help="compare baseline (accuracy_run) vs perf (accuracy_run_perf) NPU outputs; requires --use-pretrained for both")
    cmp_parser.add_argument("baseline_pt", nargs="?", help="baseline .pt (from accuracy_run.py)")
    cmp_parser.add_argument("perf_pt", nargs="?", help="perf .pt (from accuracy_run_perf.py)")
    cmp_parser.set_defaults(func=cmd_compare)

    args = parser.parse_args()

    if args.cmd == "compare":
        cmd_compare(args)
        return

    MODEL_PATH = (Path(__file__).resolve().parent / "model_files").as_posix()
    ADAPT_DIR = Path(__file__).resolve().parent

    # 1. Seed
    SEED = 42
    random.seed(SEED)
    np.random.seed(SEED)
    torch.manual_seed(SEED)
    transformers_set_seed(SEED)
    device, _, _ = get_device(force_cpu=args.cpu)
    if device.startswith("npu"):
        torch.npu.manual_seed_all(SEED)
    elif device.startswith("cuda"):
        torch.cuda.manual_seed_all(SEED)

    # 开启全局确定性算法（确保 CUDA/NPU 输出一致）
    torch.use_deterministic_algorithms(True, warn_only=True)

    # 仅在非 --cpu 模式下检查设备
    if not args.cpu:
        assert device.startswith(("npu", "cuda")), f"Need NPU or CUDA, got {device}"

