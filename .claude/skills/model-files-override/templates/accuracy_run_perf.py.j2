    all_logits = []

    with torch.no_grad():
        for i, audio in enumerate(audio_arrays):
            inputs = processor(audio, sampling_rate=16000, return_tensors="pt").to(first_device)

            # 显式设置 attention_mask 避免 pad_token 警告
