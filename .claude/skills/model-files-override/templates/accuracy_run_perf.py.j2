def get_device(force_cpu: bool = False):
    """获取推理设备。若 force_cpu=True，强制返回 CPU。

    默认优先级: NPU > CUDA > CPU
    """
    if force_cpu:
        return "cpu", 0, "cpu"

    try:
        import torch_npu

        if hasattr(torch, "npu") and torch.npu.is_available():
            device_name = torch.npu.get_device_name(0) if torch.npu.device_count() > 0 else "unknown"
            return "npu:0", torch.npu.device_count(), device_name
    except ImportError:
        pass
    if torch.cuda.is_available():
        device_name = torch.cuda.get_device_name(0)
        return "cuda:0", torch.cuda.device_count(), device_name
    return "cpu", 0, "cpu"


class _PerfMonitor:
    """性能监控器：测量推理延迟和峰值内存"""

    def __init__(self, device_type, device_ids=None):
        self.device_type = device_type
        self.device_ids = device_ids
        self.start = None
        self.latency_s = None
        self.peak_memory_mb = None

    def __enter__(self):
        if self.device_type == "npu":
            import torch_npu

            torch.npu.synchronize()
            if self.device_ids is not None:
                for dev_id in self.device_ids:
                    torch.npu.reset_peak_memory_stats(dev_id)
            else:
                torch.npu.reset_peak_memory_stats()
        elif self.device_type == "cuda":
            torch.cuda.synchronize()
            if self.device_ids is not None:
                for dev_id in self.device_ids:
                    torch.cuda.reset_peak_memory_stats(dev_id)
            else:
                torch.cuda.reset_peak_memory_stats()

        self.start = time.perf_counter()
        return self

    def __exit__(self, *args):
        if self.device_type == "npu":
            import torch_npu

            torch.npu.synchronize()
            if self.device_ids is not None:
                max_mem = 0.0
                for dev_id in self.device_ids:
                    mem = torch.npu.max_memory_allocated(dev_id)
                    max_mem = max(max_mem, mem)
                self.peak_memory_mb = max_mem / (1024**2)
            else:
                self.peak_memory_mb = torch.npu.max_memory_allocated() / (1024**2)
        elif self.device_type == "cuda":
            torch.cuda.synchronize()
            if self.device_ids is not None:
                max_mem = 0.0
                for dev_id in self.device_ids:
                    mem = torch.cuda.max_memory_allocated(dev_id)
                    max_mem = max(max_mem, mem)
                self.peak_memory_mb = max_mem / (1024**2)
            else:
                self.peak_memory_mb = torch.cuda.max_memory_allocated() / (1024**2)
        else:
            self.peak_memory_mb = 0.0

        self.latency_s = time.perf_counter() - self.start
        return False


def get_profiler_context(device_short):
    """根据硬件动态返回原生 Profiler 上下文"""
    if device_short == "npu":
        import torch_npu
        from torch_npu.profiler import ProfilerActivity as NPUActivity
        from torch_npu.profiler import profile as npu_profile

        activities = [NPUActivity.CPU, NPUActivity.NPU]
        return npu_profile(activities=activities, record_shapes=True, profile_memory=True, with_stack=True)
    else:
        activities = [torch.profiler.ProfilerActivity.CPU]
        if device_short == "cuda":
            activities.append(torch.profiler.ProfilerActivity.CUDA)

        return torch.profiler.profile(activities=activities, record_shapes=True, profile_memory=True, with_stack=True)


def measure_streaming_generation(streamer, generation_start_time):
    """使用 TextIteratorStreamer 测量 TTFT 和 TPOT

    Args:
        streamer: TextIteratorStreamer 实例
        generation_start_time: 生成开始的时间戳 (time.perf_counter())

    Returns:
        tuple: (generated_text, ttft_ms, tpot_ms)
            - generated_text: 生成的文本
            - ttft_ms: 首字延迟（毫秒），若无 token 则为 None
            - tpot_ms: 平均每 token 生成时间（毫秒），若无后续 token 则为 None
    """
    token_times = []
    generated_text = ""

    for token in streamer:
        token_times.append(time.perf_counter())
        generated_text += token

    # 计算 TTFT（首 token 相对于生成开始的时间）
    if len(token_times) >= 1:
        ttft_ms = (token_times[0] - generation_start_time) * 1000
        if len(token_times) >= 2:
            # TPOT = (最后一个 token 时间 - 第一个 token 时间) / (token 数 - 1)
            total_time_after_first = token_times[-1] - token_times[0]
            n_tokens_after_first = len(token_times) - 1
            tpot_ms = (total_time_after_first / n_tokens_after_first) * 1000
        else:
            tpot_ms = None
    else:
        ttft_ms = None
        tpot_ms = None

    return generated_text, ttft_ms, tpot_ms


def get_dtype_str(dtype: torch.dtype) -> str:
    """Convert torch dtype to short string (fp32, fp16, bf16)."""
    dtype_map = {
        torch.float32: "fp32",
        torch.float16: "fp16",
        torch.bfloat16: "bf16",
        torch.int64: "int64",
        torch.int32: "int32",
    }
    return dtype_map.get(dtype, str(dtype).replace("torch.", ""))


def get_package_versions() -> dict:
    """获取关键依赖包的版本"""
    import importlib.metadata
    packages = ["torch", "transformers", "torch_npu", "numpy", "datasets"]
    versions = {}
    for pkg in packages:
        try:
            versions[pkg] = importlib.metadata.version(pkg)
        except importlib.metadata.PackageNotFoundError:
            versions[pkg] = "not_installed"
    return versions


def _first_existing(paths: list) -> Optional[Path]:
    for p in paths:
        if p.exists():
            return p
    return None


def merge_baseline_comparison(adapt_dir: Path, device_short: str, dtype_str: str, mode_str: str, dataset_name: str, perf_metrics: dict, first_device=None) -> dict:
    """若存在 baseline（accuracy_run.py 产出），将优化前后对比写入 perf_metrics。兼容 npu/npu_0、cuda/cuda_0。"""
    candidates = [adapt_dir / f"benchmark_metrics_{device_short}_{dtype_str}_{mode_str}_{dataset_name}.json"]
    if first_device and (alt := str(first_device).replace(":", "_")) != device_short:
        candidates.append(adapt_dir / f"benchmark_metrics_{alt}_{dtype_str}_{mode_str}_{dataset_name}.json")
    baseline_path = _first_existing(candidates)
    if not baseline_path:
        return perf_metrics
    try:
        baseline = json.loads(baseline_path.read_text(encoding="utf-8"))
    except Exception:
        return perf_metrics

    out = dict(perf_metrics)
    out["baseline_file"] = baseline_path.name
    for bl_key, pf_key, out_prefix, ratio_key, pct_key, prec in [
        ("latency_s", "latency_s", "baseline_latency_s", "speedup_ratio", "latency_reduction_pct", 6),
        ("peak_memory_mb", "peak_memory_mb", "baseline_peak_memory_mb", None, "memory_reduction_pct", 2),
        ("ttft_ms", "ttft_ms", "baseline_ttft_ms", "ttft_speedup_ratio", None, 3),
        ("tpot_ms", "tpot_ms", "baseline_tpot_ms", "tpot_speedup_ratio", None, 3),
    ]:
        bl_val, pf_val = baseline.get(bl_key), perf_metrics.get(pf_key)
        ok = bl_val is not None and pf_val is not None and (pf_val > 0 if ratio_key else bl_val > 0)
        if ok:
            out[out_prefix] = round(bl_val, prec)
            if ratio_key:
                out[ratio_key] = round(bl_val / pf_val, 4)
            if pct_key:
                out[pct_key] = round((bl_val - pf_val) / bl_val * 100, 2)
    return out


def _baseline_output_candidates(adapt_dir: Path, perf_name: str) -> list:
    """Baseline outputs 候选路径（兼容 npu_0/cuda_0）。"""
    base = perf_name.replace("_perf.pt", ".pt")
    candidates = [adapt_dir / base]
    if "outputs_npu_" in base and "outputs_npu_0_" not in base:
        candidates.append(adapt_dir / base.replace("outputs_npu_", "outputs_npu_0_", 1))
    elif "outputs_cuda_" in base and "outputs_cuda_0_" not in base:
        candidates.append(adapt_dir / base.replace("outputs_cuda_", "outputs_cuda_0_", 1))
    return candidates


def merge_output_comparison(adapt_dir: Path, outputs_path: Path, perf_metrics: dict) -> dict:
    """若存在 baseline outputs_*.pt，对比产出并写入 perf_metrics。"""
    baseline_path = _first_existing(_baseline_output_candidates(adapt_dir, outputs_path.name))
    if not baseline_path:
        return perf_metrics
    try:
        result = run_compare(baseline_path, outputs_path)
    except Exception as e:
        return {**perf_metrics, "output_compare": {"error": str(e)}}
    compare_data = {k: v for k, v in result.items() if k not in ("cuda_pt", "ascend_pt")}
    compare_data["baseline_pt"], compare_data["perf_pt"] = baseline_path.name, outputs_path.name
    return {**perf_metrics, "output_compare": compare_data}


