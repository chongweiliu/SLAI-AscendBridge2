            )
            transcription = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]
            all_transcriptions.append(transcription)

            # 通过 forward 提取最后一个 token 的 logits（encoder-decoder：decoder_input_ids[:-1] -> logits[-1] 预测最后 token）
            try:
                decoder_input_ids = generated_ids[:, :-1]
                if decoder_input_ids.shape[1] > 0:
                    forward_inputs = {k: v for k, v in inputs.items()}
                    forward_inputs["decoder_input_ids"] = decoder_input_ids.to(first_device)
                    outputs = model(**forward_inputs)
                    last_logits = outputs.logits[0, -1, :].cpu()
                    all_logits.append(last_logits)
                else:
                    # 空序列（如静音），用零向量占位以保持样本对齐
                    vocab_size = model.config.vocab_size if hasattr(model.config, "vocab_size") else 51865
                    all_logits.append(torch.zeros(vocab_size, dtype=torch.float32))
            except Exception as e:
                print(f"[benchmark] Warning: logits extraction failed for sample {i}: {e}")
                vocab_size = model.config.vocab_size if hasattr(model.config, "vocab_size") else 51865
                all_logits.append(torch.zeros(vocab_size, dtype=torch.float32))

            del inputs, generated_ids

            if (i + 1) % 32 == 0:
                if device_short == "npu":
                    torch.npu.empty_cache()
                elif device_short == "cuda":
                    torch.cuda.empty_cache()
                print(f"[benchmark] processed {i + 1}/{len(audio_arrays)} audio samples (cache cleared)")

            elif (i + 1) % 8 == 0:
                print(f"[benchmark] processed {i + 1}/{len(audio_arrays)} audio samples")

    # 保存 outputs（mixed 格式：generated_text + logits，与 CausalLM 一致，便于 benchmark_tool compare）
    output_data = {
        "generated_text": all_transcriptions,
        "logits": all_logits,
    }
    torch.save(output_data, outputs_path)

    print(f"[benchmark] outputs saved to {outputs_path}")
    print(f"[benchmark]   - generated_text (transcriptions): {len(all_transcriptions)} samples")
    print(f"[benchmark]   - logits: {len(all_logits)} samples" + (f", shape: {all_logits[0].shape}" if all_logits else ""))

    return outputs_path, None, None  # ASR 不测 TTFT/TPOT


