#!/usr/bin/env bash
# 裸机一键部署（deploy-baremetal.sh）
# 由 vllm-ascend-auto-deploy Skill 按 deploy-config.yaml 渲染。
# 用法: bash deploy-baremetal.sh [start|stop|status]
#   start (默认): 加载镜像(若 local_tar) -> preflight -> 起角色 -> /v1/models -> 语义断言
#   stop: 仅停止本次起的进程
#   status: 查 /v1/models 与进程
# jinja2 变量：{{ var }} 由部署拓扑填充。

set -euo pipefail

DEPLOY_DIR="{{ deploy_dir }}"
PROJECT_ROOT="{{ project_root }}"
MODEL_NAME="{{ model_name }}"
PORT={{ port }}
IMAGE_REF="{{ image_ref }}"
IMAGE_SOURCE="{{ image_source }}"
IMAGE_LOCAL_TAR="{{ image_local_tar }}"
RUNTIME_KIND="{{ runtime_kind }}"
START_SCRIPT="run/{{ start_script }}"
INFER_VALIDATOR="scripts/validate_inference_result.py"

cd "$DEPLOY_DIR"

runkind_container () {
  # 容器化裸机：先 docker load 本地 tar（自闭环）
  if [ "$IMAGE_SOURCE" = "local_tar" ] && [ -n "$IMAGE_LOCAL_TAR" ]; then
    if [ -f "$PROJECT_ROOT/$IMAGE_LOCAL_TAR" ]; then
      echo "[baremetal] docker load -i $PROJECT_ROOT/$IMAGE_LOCAL_TAR"
      docker load -i "$PROJECT_ROOT/$IMAGE_LOCAL_TAR"
    else
      echo "[baremetal] FATAL: 本地镜像 tar 缺失 $PROJECT_ROOT/$IMAGE_LOCAL_TAR"; exit 1
    fi
  fi
}

do_start () {
  echo "[baremetal] === 1/4 preflight ==="
  bash run/preflight_check.sh

  echo "[baremetal] === 2/4 load image (if local_tar) ==="
  if [ "$RUNTIME_KIND" = "container" ]; then
    runkind_container
  else
    echo "[baremetal] runtime_kind=$RUNTIME_KIND，跳过 docker load"
  fi

  echo "[baremetal] === 3/4 start roles ==="
  bash "$START_SCRIPT"

  echo "[baremetal] === 4/4 poll /v1/models + semantic assert ==="
  for i in $(seq 1 120); do
    if curl -sf "http://127.0.0.1:${PORT}/v1/models" >/dev/null 2>&1; then
      echo "[baremetal] /v1/models 200 (after ${i}0s)"
      break
    fi
    sleep 10
    [ "$i" = "120" ] && { echo "[baremetal] FATAL: /v1/models 超时未就绪"; do_stop; exit 1; }
  done

  python "$PROJECT_ROOT/$INFER_VALIDATOR" --endpoint "http://127.0.0.1:${PORT}" --model "$MODEL_NAME" \
    || { echo "[baremetal] FATAL: 语义断言失败"; do_stop; exit 1; }

  echo "[baremetal] SUCCESS: endpoint=http://127.0.0.1:${PORT}"
  echo "[baremetal] logs: $DEPLOY_DIR/logs/"
  echo "[baremetal] stop: bash deploy-baremetal.sh stop"
}

do_stop () {
  echo "[baremetal] stopping roles..."
  pkill -f "vllm.*$MODEL_NAME" 2>/dev/null || true
  pkill -f "stable_cluster_supervisor" 2>/dev/null || true
  pkill -f "pd_proxy_server" 2>/dev/null || true
}

do_status () {
  curl -sf "http://127.0.0.1:${PORT}/v1/models" && echo "" || echo "[baremetal] service down"
  pgrep -af "vllm|stable_cluster|pd_proxy" || echo "[baremetal] no vllm procs"
}

case "${1:-start}" in
  start) do_start ;;
  stop) do_stop ;;
  status) do_status ;;
  *) echo "usage: $0 [start|stop|status]"; exit 2 ;;
esac
