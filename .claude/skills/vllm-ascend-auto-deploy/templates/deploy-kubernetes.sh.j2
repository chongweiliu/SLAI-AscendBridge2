#!/usr/bin/env bash
# Kubernetes one-click deployment generated by vllm-ascend-auto-deploy.
# Usage: bash deploy-kubernetes.sh [submit|delete|status|logs]

set -euo pipefail

DEPLOY_DIR={{ deploy_dir_shell }}
PROJECT_ROOT={{ project_root_shell }}
MANIFEST={{ kubernetes_manifest_shell }}
REQUEST={{ deploy_request_shell }}
NAMESPACE={{ namespace_shell }}
KUBE_CONTEXT={{ kube_context_shell }}
WORKLOAD={{ workload_name_shell }}
WORKLOADS=({{ workload_names_array }})
LOG_TARGET={{ log_target_shell }}
PD_MODE={{ "true" if pd_mode else "false" }}
API_SERVICE={{ api_service_name_shell }}
INFERENCE_PAYLOAD={{ inference_payload_shell }}
INFERENCE_ENDPOINT={{ inference_endpoint_shell }}
VALIDATOR_ARGS=({{ validator_args_array }})
SERVICE_PORT={{ service_port }}
KUBECTL_BIN="${KUBECTL_BIN:-kubectl}"

kube_args=()
if [ -n "$KUBE_CONTEXT" ]; then
  kube_args+=(--context "$KUBE_CONTEXT")
fi

kube() {
  "$KUBECTL_BIN" "${kube_args[@]}" "$@"
}

do_submit() {
  cd "$DEPLOY_DIR"
  echo "[kubernetes] === 1/6 validate artifacts ==="
  python "$PROJECT_ROOT/.claude/skills/vllm-ascend-auto-deploy/scripts/validate_kubernetes_manifest.py" \
    "$MANIFEST" --request "$REQUEST"

  echo "[kubernetes] === 2/6 client/server dry-run ==="
  kube apply --dry-run=client -f "$MANIFEST" >/dev/null
  kube apply --dry-run=server -f "$MANIFEST" >/dev/null

  echo "[kubernetes] === 3/6 verify frozen artifact ==="
  python "$PROJECT_ROOT/.claude/skills/vllm-ascend-auto-deploy/scripts/validate_frozen_artifact.py" \
    "$DEPLOY_DIR"

  echo "[kubernetes] === 4/6 apply ==="
  kube apply -f "$MANIFEST"

  echo "[kubernetes] === 5/6 wait for role workloads ==="
  local role_workload
  for role_workload in "${WORKLOADS[@]}"; do
    if ! kube -n "$NAMESPACE" rollout status "statefulset/$role_workload" --timeout=30m; then
      kube -n "$NAMESPACE" get pods -l "app.kubernetes.io/instance=$role_workload" -o wide || true
      kube -n "$NAMESPACE" logs "$role_workload-0" --tail=200 || true
      do_delete
      return 1
    fi
  done
  if [ "$PD_MODE" = "true" ]; then
    kube -n "$NAMESPACE" rollout status "$LOG_TARGET" --timeout=10m || {
      kube -n "$NAMESPACE" logs "$LOG_TARGET" --tail=200 || true
      do_delete
      return 1
    }
  fi

  echo "[kubernetes] === 6/6 semantic inference through temporary port-forward ==="
  local_port="${LOCAL_PORT:-$SERVICE_PORT}"
  runtime_dir="${TMPDIR:-/tmp}/slai-k8s-${WORKLOAD}-$$"
  mkdir -p "$runtime_dir"
  kube -n "$NAMESPACE" port-forward "service/$API_SERVICE" \
    "${local_port}:${SERVICE_PORT}" >"$runtime_dir/port-forward.log" 2>&1 &
  port_forward_pid=$!
  cleanup_port_forward() {
    kill "$port_forward_pid" 2>/dev/null || true
  }
  trap cleanup_port_forward EXIT
  for _ in $(seq 1 30); do
    health_path="/v1/models"
    [ "$PD_MODE" != "true" ] || health_path="/healthcheck"
    curl -sf "http://127.0.0.1:${local_port}${health_path}" >/dev/null 2>&1 && break
    sleep 2
  done
  response_file="$runtime_dir/inference-response.json"
  curl -sf "http://127.0.0.1:${local_port}${INFERENCE_ENDPOINT}" \
    -H "Content-Type: application/json" \
    -d "$INFERENCE_PAYLOAD" \
    >"$response_file" || {
      kube -n "$NAMESPACE" logs "$LOG_TARGET" --tail=200 || true
      do_delete
      return 1
  }
  python "$PROJECT_ROOT/.claude/skills/vllm-ascend-auto-deploy/scripts/validate_inference_result.py" \
    "$response_file" "${VALIDATOR_ARGS[@]}" || {
      kube -n "$NAMESPACE" logs "$LOG_TARGET" --tail=200 || true
      do_delete
      return 1
    }
  cleanup_port_forward
  trap - EXIT
  echo "[kubernetes] SUCCESS: service/$API_SERVICE namespace=$NAMESPACE"
  echo "[kubernetes] local access: kubectl -n $NAMESPACE port-forward service/$API_SERVICE $SERVICE_PORT:$SERVICE_PORT"
}

do_delete() {
  kube delete -f "$DEPLOY_DIR/$MANIFEST" --ignore-not-found
}

do_status() {
  local role_workload
  for role_workload in "${WORKLOADS[@]}"; do
    kube -n "$NAMESPACE" get "statefulset/$role_workload"
    kube -n "$NAMESPACE" get pods -l "app.kubernetes.io/instance=$role_workload" -o wide
  done
  kube -n "$NAMESPACE" get "service/$API_SERVICE"
}

do_logs() {
  kube -n "$NAMESPACE" logs "$LOG_TARGET" --tail="${TAIL_LINES:-200}"
}

case "${1:-submit}" in
  submit) do_submit ;;
  delete) do_delete ;;
  status) do_status ;;
  logs) do_logs ;;
  *) echo "usage: $0 [submit|delete|status|logs]"; exit 2 ;;
esac
