#!/usr/bin/env bash
# One-click SSH deployment generated by vllm-ascend-auto-deploy.
# Usage: bash deploy-ssh.sh [start|stop|status|logs]

set -euo pipefail

DEPLOY_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REMOTE_DIR={{ remote_dir_shell }}
REMOTE_SCRIPT="$REMOTE_DIR/remote-node.sh"
NODE_COUNT={{ node_count }}
MULTI_NODE={{ "true" if multi_node else "false" }}
SERVICE_PORT={{ service_port }}
INFERENCE_PAYLOAD={{ inference_payload_shell }}
NODE_HOSTS=({{ node_hosts_array }})
NODE_USERS=({{ node_users_array }})
NODE_PORTS=({{ node_ports_array }})
NODE_AUTH=({{ node_auth_array }})
NODE_IDENTITIES=({{ node_identity_array }})
NODE_FINGERPRINTS=({{ node_fingerprints_array }})
NODE_NETWORK_ADDRESSES=({{ node_network_addresses_array }})
NODE_NETWORK_INTERFACES=({{ node_network_interfaces_array }})
SSH_BIN="${SSH_BIN:-ssh}"
SCP_BIN="${SCP_BIN:-scp}"
umask 077
RUNTIME_DIR="/tmp/slai-ssh-${UID:-user}-$$"
KNOWN_HOSTS="$RUNTIME_DIR/known_hosts"

mkdir -p "$RUNTIME_DIR"
PORT_FORWARD_PID=""
STARTED=0
CONTROL_OPENED=()

cleanup_local() {
  if [ -n "$PORT_FORWARD_PID" ]; then
    kill "$PORT_FORWARD_PID" 2>/dev/null || true
  fi
  close_control_connections
  rm -rf "$RUNTIME_DIR"
}

on_exit() {
  local status=$?
  if [ "$status" -ne 0 ] && [ "$STARTED" -eq 1 ]; then
    stop_all || true
  fi
  cleanup_local
  exit "$status"
}
trap on_exit EXIT

ssh_options() {
  local index="$1"
  SSH_OPTIONS=(
    -p "${NODE_PORTS[$index]}"
    -o BatchMode=yes
    -o StrictHostKeyChecking=yes
    -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o ConnectTimeout=15
    -o ServerAliveInterval=15
    -o ServerAliveCountMax=3
    -o ExitOnForwardFailure=yes
  )
  if [ "${NODE_AUTH[$index]}" = "key" ]; then
    SSH_OPTIONS+=(-o IdentitiesOnly=yes -i "${NODE_IDENTITIES[$index]}")
  elif [ "${NODE_AUTH[$index]}" = "password" ]; then
    SSH_OPTIONS+=(
      -o "ControlPath=$RUNTIME_DIR/control-$index"
      -o ControlMaster=no
      -o PreferredAuthentications=password
      -o PubkeyAuthentication=no
    )
  fi
}

scp_options() {
  local index="$1"
  SCP_OPTIONS=(
    -P "${NODE_PORTS[$index]}"
    -o BatchMode=yes
    -o StrictHostKeyChecking=yes
    -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o ConnectTimeout=15
  )
  if [ "${NODE_AUTH[$index]}" = "key" ]; then
    SCP_OPTIONS+=(-o IdentitiesOnly=yes -i "${NODE_IDENTITIES[$index]}")
  elif [ "${NODE_AUTH[$index]}" = "password" ]; then
    SCP_OPTIONS+=(
      -o "ControlPath=$RUNTIME_DIR/control-$index"
      -o ControlMaster=no
      -o PreferredAuthentications=password
      -o PubkeyAuthentication=no
    )
  fi
}

open_password_connections() {
  local index
  for ((index = 0; index < NODE_COUNT; index++)); do
    if [ "${NODE_AUTH[$index]}" != "password" ]; then
      CONTROL_OPENED+=(0)
      continue
    fi
    echo "SSH password required for ${NODE_USERS[$index]}@${NODE_HOSTS[$index]}"
    "$SSH_BIN" \
      -p "${NODE_PORTS[$index]}" \
      -o BatchMode=no \
      -o NumberOfPasswordPrompts=1 \
      -o PreferredAuthentications=password \
      -o PubkeyAuthentication=no \
      -o StrictHostKeyChecking=yes \
      -o "UserKnownHostsFile=$KNOWN_HOSTS" \
      -o ConnectTimeout=15 \
      -o ControlMaster=yes \
      -o ControlPersist=600 \
      -o "ControlPath=$RUNTIME_DIR/control-$index" \
      -Nf "${NODE_USERS[$index]}@${NODE_HOSTS[$index]}"
    CONTROL_OPENED+=(1)
  done
}

close_control_connections() {
  local index
  for index in "${!CONTROL_OPENED[@]}"; do
    if [ "${CONTROL_OPENED[$index]}" != 1 ]; then
      continue
    fi
    "$SSH_BIN" \
      -p "${NODE_PORTS[$index]}" \
      -o "ControlPath=$RUNTIME_DIR/control-$index" \
      -O exit "${NODE_USERS[$index]}@${NODE_HOSTS[$index]}" \
      >/dev/null 2>&1 || true
  done
  CONTROL_OPENED=()
}

remote_command() {
  local index="$1"
  shift
  ssh_options "$index"
  local command
  printf -v command 'bash %q' "$REMOTE_SCRIPT"
  local argument
  for argument in "$@"; do
    printf -v command '%s %q' "$command" "$argument"
  done
  "$SSH_BIN" "${SSH_OPTIONS[@]}" \
    "${NODE_USERS[$index]}@${NODE_HOSTS[$index]}" "$command"
}

prepare_known_hosts() {
  : >"$KNOWN_HOSTS"
  command -v ssh-keyscan >/dev/null 2>&1 || {
    echo "ERROR: ssh-keyscan is required" >&2
    return 1
  }
  command -v ssh-keygen >/dev/null 2>&1 || {
    echo "ERROR: ssh-keygen is required" >&2
    return 1
  }
  local index scan_file line fingerprint matched
  for ((index = 0; index < NODE_COUNT; index++)); do
    scan_file="$RUNTIME_DIR/keyscan-$index"
    ssh-keyscan -T 10 -p "${NODE_PORTS[$index]}" "${NODE_HOSTS[$index]}" \
      >"$scan_file" 2>/dev/null || true
    [ -s "$scan_file" ] || {
      echo "ERROR: cannot scan SSH host key for ${NODE_HOSTS[$index]}" >&2
      return 1
    }
    matched=0
    while IFS= read -r line; do
      fingerprint="$(
        printf '%s\n' "$line" |
          ssh-keygen -lf - -E sha256 2>/dev/null |
          awk '{print $2}'
      )"
      if [ "$fingerprint" = "${NODE_FINGERPRINTS[$index]}" ]; then
        printf '%s\n' "$line" >>"$KNOWN_HOSTS"
        matched=1
      fi
    done <"$scan_file"
    [ "$matched" -eq 1 ] || {
      echo "ERROR: SSH host-key fingerprint mismatch for ${NODE_HOSTS[$index]}" >&2
      return 1
    }
  done
}

upload_artifacts() {
  local index
  for ((index = 0; index < NODE_COUNT; index++)); do
    ssh_options "$index"
    "$SSH_BIN" "${SSH_OPTIONS[@]}" \
      "${NODE_USERS[$index]}@${NODE_HOSTS[$index]}" \
      "mkdir -p '$REMOTE_DIR'"
    scp_options "$index"
    "$SCP_BIN" "${SCP_OPTIONS[@]}" \
      "$DEPLOY_DIR/remote-node.sh" \
      "${NODE_USERS[$index]}@${NODE_HOSTS[$index]}:$REMOTE_DIR/remote-node.sh"
  done
}

preflight_all() {
  local index
  for ((index = 0; index < NODE_COUNT; index++)); do
    remote_command "$index" preflight "$index"
  done
}

discover_network() {
  NETWORK_IPS=()
  NETWORK_INTERFACES=()
  local index probe info
  for ((index = 0; index < NODE_COUNT; index++)); do
    if [ "$MULTI_NODE" != "true" ]; then
      probe=""
    elif [ "$index" -eq 0 ]; then
      probe="${NODE_HOSTS[1]}"
    else
      probe="${NODE_HOSTS[0]}"
    fi
    info="$(
      remote_command "$index" network \
        "${NODE_NETWORK_ADDRESSES[$index]}" \
        "${NODE_NETWORK_INTERFACES[$index]}" \
        "$probe" | tail -n 1
    )"
    [[ "$info" == *"|"* ]] || {
      echo "ERROR: invalid network discovery result from ${NODE_HOSTS[$index]}" >&2
      return 1
    }
    NETWORK_IPS+=("${info%%|*}")
    NETWORK_INTERFACES+=("${info#*|}")
  done
  if [ "$MULTI_NODE" = "true" ]; then
    [ "$(printf '%s\n' "${NETWORK_IPS[@]}" | sort -u | wc -l | tr -d ' ')" -eq "$NODE_COUNT" ] || {
      echo "ERROR: SSH nodes resolved to duplicate communication addresses" >&2
      return 1
    }
  fi
}

stop_all() {
  local index
  for ((index = NODE_COUNT - 1; index >= 0; index--)); do
    remote_command "$index" stop "$index" || true
  done
  STARTED=0
}

start_all() {
  local index
  # A lost SSH response can occur after the remote process has started.
  # Mark cleanup necessary before issuing the first mutating command.
  STARTED=1
  for ((index = NODE_COUNT - 1; index >= 1; index--)); do
    remote_command "$index" start "$index" \
      "${NETWORK_IPS[0]}" "${NETWORK_IPS[$index]}" "${NETWORK_INTERFACES[$index]}"
  done
  remote_command 0 start 0 \
    "${NETWORK_IPS[0]}" "${NETWORK_IPS[0]}" "${NETWORK_INTERFACES[0]}"
}

start_port_forward() {
  local local_port="$1"
  ssh_options 0
  "$SSH_BIN" "${SSH_OPTIONS[@]}" -N \
    -L "127.0.0.1:${local_port}:127.0.0.1:${SERVICE_PORT}" \
    "${NODE_USERS[0]}@${NODE_HOSTS[0]}" \
    >"$RUNTIME_DIR/port-forward.log" 2>&1 &
  PORT_FORWARD_PID=$!
}

validate_inference() {
  local local_port
  if [ -n "${LOCAL_PORT:-}" ]; then
    local_port="$LOCAL_PORT"
    python3 - "$local_port" <<'PY'
import socket
import sys

port = int(sys.argv[1])
with socket.socket() as listener:
    listener.bind(("127.0.0.1", port))
PY
  else
    local_port="$(
      python3 - <<'PY'
import socket

with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
    )"
  fi
  start_port_forward "$local_port"
  sleep 1
  kill -0 "$PORT_FORWARD_PID" 2>/dev/null || {
    cat "$RUNTIME_DIR/port-forward.log" >&2 || true
    echo "ERROR: SSH port-forward failed" >&2
    return 1
  }
  local ready=0
  for _ in $(seq 1 180); do
    if curl -sf "http://127.0.0.1:${local_port}/v1/models" >/dev/null 2>&1; then
      ready=1
      break
    fi
    kill -0 "$PORT_FORWARD_PID" 2>/dev/null || break
    sleep 10
  done
  [ "$ready" -eq 1 ] || {
    remote_command 0 logs 0 || true
    echo "ERROR: SSH deployment did not become ready" >&2
    return 1
  }
  local response="$RUNTIME_DIR/inference-response.json"
  curl -sf "http://127.0.0.1:${local_port}/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -d "$INFERENCE_PAYLOAD" >"$response"
  python3 "$DEPLOY_DIR/validate_inference_result.py" \
    "$response" --expected-regex '\s*4\s*'
}

do_start() {
  python3 "$DEPLOY_DIR/validate_frozen_artifact.py" "$DEPLOY_DIR"
  prepare_known_hosts
  open_password_connections
  upload_artifacts
  preflight_all
  discover_network
  start_all
  validate_inference
  cleanup_local
  trap - EXIT
  echo "SUCCESS: SSH vLLM deployment is running"
  echo "remote directory: $REMOTE_DIR"
  echo "stop: bash $0 stop"
}

do_stop() {
  prepare_known_hosts
  open_password_connections
  stop_all
}

do_status() {
  prepare_known_hosts
  open_password_connections
  local index status=0
  for ((index = 0; index < NODE_COUNT; index++)); do
    remote_command "$index" status "$index" || status=1
  done
  return "$status"
}

do_logs() {
  prepare_known_hosts
  open_password_connections
  remote_command 0 logs 0
}

case "${1:-start}" in
  start) do_start ;;
  stop) do_stop ;;
  status) do_status ;;
  logs) do_logs ;;
  *) echo "usage: $0 [start|stop|status|logs]" >&2; exit 2 ;;
esac
