#!/usr/bin/env python
# -*- coding: utf-8 -*-
# cpt_audio_llm.py.tmpl — 音频-LLM(audio-text-to-text) 通用继续预训练 CPT (NPU)
# 通用: 按 config.architectures 自动识别模型类(Qwen2Audio/QwenAudio/...); 从 tokenizer 自动发现 audio token。
# 自动调参: 探测 device_count+free_mem → 自动选 单卡/2卡模型并行(max_memory按显存算)/LoRA回退;
#           lr=sqrt(global_batch) 自动, warmup~10%, bs 带 OOM 回退阶梯, grad_accum 凑有效 batch。
# 见 references/audio-llm-cpt.md; 并行/lr 规则对齐 parallel-strategy.md / hyperparam-selection.md。
import sklearn  # noqa  必先! libgomp TLS 修复(#55)
import os, json, time, sys, subprocess, random, io, math, inspect
os.environ.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD","0")
os.environ.setdefault("TASK_QUEUE_ENABLE","1")
os.environ.setdefault("PYTORCH_NPU_ALLOC_CONF","expandable_segments:True")
import torch, torch_npu  # noqa
import soundfile as sf, numpy as np
try:
    import pyarrow.parquet as pq
except Exception:
    pq=None
from transformers import AutoProcessor, AutoModelForConditionalGeneration, AutoConfig

WS=os.environ["WS_DIR"]; MODEL=os.environ["MODEL_DIR"]; OUT=os.path.join(WS,"outputs"); LOG=os.path.join(WS,"logs")
os.makedirs(OUT,exist_ok=True); os.makedirs(LOG,exist_ok=True)
STEPS=int(os.environ.get("NUM_STEPS","100")); SEED=42; RATIO=float(os.environ.get("RATIO","0.3"))
N_KEEP=int(os.environ.get("N_KEEP","150")); GRAD_ACCUM=int(os.environ.get("GRAD_ACCUM","1")); BS=int(os.environ.get("BATCH_SIZE","0"))  # 0=自动
LR_ENV=os.environ.get("LR","0")  # "0"=自动
WARMUP_ENV=int(os.environ.get("WARMUP","0"))  # 0=自动
TRANSCRIBE_PROMPT=os.environ.get("TRANSCRIBE_PROMPT","Transcribe the audio into text.")
# 强制覆盖(可选): MODE=auto|single|mp2|lora; 0=自动按显存
MODE_FORCE=os.environ.get("MODE","auto")
random.seed(SEED); torch.manual_seed(SEED)

# ---- 通用: 按 config.architectures 自动识别音频-LLM 类 ----
_ARCH_MAP={
    "Qwen2AudioForConditionalGeneration":("transformers","Qwen2AudioForConditionalGeneration"),
    "QwenAudioForConditionalGeneration":("transformers","QwenAudioForConditionalGeneration"),
}
def load_model_class():
    cfg=AutoConfig.from_pretrained(MODEL, trust_remote_code=True)
    archs=getattr(cfg,"architectures",None) or [type(cfg).__name__]
    for a in archs:
        if a in _ARCH_MAP:
            mod_name,cls_name=_ARCH_MAP[a]
            try:
                mod=__import__(mod_name, fromlist=[cls_name]); return getattr(mod,cls_name), a
            except Exception: pass
    # 回退: AutoModelForConditionalGeneration(通用, 支持大多数 audio-LLM)
    print(f"[model] architectures={archs} 无专用映射 → 回退 AutoModelForConditionalGeneration(通用)", flush=True)
    return AutoModelForConditionalGeneration, (archs[0] if archs else "auto")

def discover_audio_token_ids(tok):
    """从 tokenizer 自动发现 audio 特殊 token(名含 audio/AUDIO, 不写死 Qwen2-Audio 的3个)。"""
    ids=set()
    vocab=tok.get_vocab() if hasattr(tok,"get_vocab") else {}
    for t,i in vocab.items():
        tl=t.lower()
        if ("audio" in tl) and (t.startswith("<") or t.startswith("▁<") or t.startswith("[") or t in ("<AUDIO>","<|audio|>")):
            ids.add(int(i))
    # 兜底: added_tokens
    try:
        for t in tok.added_tokens_encoder:
            if "audio" in t.lower(): ids.add(int(tok.convert_tokens_to_ids(t)))
    except Exception: pass
    print(f"[audio-tokens] discovered {len(ids)} audio tokens: {sorted(vocab,k=lambda k:vocab[k])[:0] or ''}{sorted(ids)[:6]}", flush=True)
    return ids

def load_samples():
    dp=os.environ["DATA_FILE"]; samples=[]
    if dp.endswith(".parquet") and pq is not None:
        t=pq.read_table(dp); cols=t.column_names
        tcol="transcription" if "transcription" in cols else ("raw_transcription" if "raw_transcription" in cols else "text")
        rows=t.to_pylist(); rng=random.Random(SEED); rng.shuffle(rows)
        for r in rows[:N_KEEP]:
            a=r.get("audio",{}); b=a.get("bytes")
            if not b: continue
            try:
                arr,sr=sf.read(io.BytesIO(b))
                if arr.ndim>1: arr=arr[:,0]
                if sr!=16000: continue
                txt=str(r.get(tcol,"")).strip()
                if not txt: continue
                samples.append({"audio":arr.astype(np.float32),"text":txt})
            except Exception: continue
            if len(samples)>=N_KEEP: break
    print(f"[data] loaded {len(samples)} samples", flush=True)
    return samples

def build_inputs(proc, samples, dev0, audio_ids, fwd_params):
    U=[{"type":"audio","audio_url":"x"},{"type":"text","text":TRANSCRIBE_PROMPT}]
    fulls=[]; prompts=[]; arrs=[]
    for s in samples:
        fulls.append(proc.apply_chat_template([{"role":"user","content":U},{"role":"assistant","content":s["text"]}],tokenize=False,add_generation_prompt=False))
        prompts.append(proc.apply_chat_template([{"role":"user","content":U}],tokenize=False,add_generation_prompt=True))
        arrs.append(s["audio"])
    inp=proc(text=fulls, audio=arrs, padding=True, return_tensors="pt", sampling_rate=16000)  # audio= 单数(#56)
    pinp=proc(text=prompts, audio=arrs, padding=True, return_tensors="pt", sampling_rate=16000)
    ids=inp.input_ids.to(dev0); am=inp.attention_mask.to(dev0)
    af=inp.input_features.to(dev0)
    # auto-detect audio mask kwarg(#63): Qwen2-Audio=feature_attention_mask, MOSS=audio_feature_lengths; 通用按 forward 签名动态传
    audio_kwargs={}
    for k in ("feature_attention_mask","audio_feature_lengths"):
        if k in fwd_params and hasattr(inp,k): audio_kwargs[k]=getattr(inp,k).to(dev0)
    if not audio_kwargs: print(f"[warn] forward 无 audio mask kwarg(既非 feature_attention_mask 也非 audio_feature_lengths)",flush=True)
    labels=ids.clone(); labels[am==0]=-100
    for i in range(len(samples)): labels[i,:int(pinp.attention_mask[i].sum())]=-100
    for a in audio_ids: labels[ids==a]=-100  # 显式 mask audio 特殊 token(#58)
    return ids, am, af, audio_kwargs, labels

def probe_hardware():
    n=torch.npu.device_count()
    frees=[]
    for i in range(max(1,n)):
        try: frees.append(torch.npu.mem_get_info(i)[0]/1e9)
        except Exception: frees.append(60.0)
    free=min(frees) if frees else 60.0
    print(f"[hw] device_count={n} free/card~{free:.1f}GB", flush=True)
    return n, free

def auto_parallel(P_B, n_card, free_GB, mode_force):
    """据模型参数量P(B) + 卡数 + 显存, 自动选 single/mp2/lora + max_memory。
    估算(全量CPT): bf16 master≈8*P GB, fp32 master≈16*P GB(见 parallel-strategy.md)。
    single: 8*P ≤ free*0.8; mp2: n_card≥2 且 8*P/2 ≤ free*0.8; 否则 lora 回退(冻结base)。"""
    full_bf16=8*P_B
    if mode_force in ("single","mp2","lora"):
        mode=mode_force
    elif full_bf16 <= free_GB*0.8:
        mode="single"
    elif n_card>=2 and full_bf16/2 <= free_GB*0.8:
        mode="mp2"
    else:
        mode="lora"
    # max_memory(模型放置, 留余量给 optim/grad/激活): 每卡 cap = free*0.5
    max_mem={i:f"{int(free_GB*0.5)}GB" for i in range(n_card)} if n_card>=2 else None
    print(f"[auto-parallel] P={P_B:.2f}B full_bf16≈{full_bf16:.1f}GB free={free_GB:.1f}GB n_card={n_card} → mode={mode} max_mem={max_mem}", flush=True)
    return mode, max_mem

def main():
    proc=AutoProcessor.from_pretrained(MODEL)
    ModelCls, arch = load_model_class()
    audio_ids=discover_audio_token_ids(proc.tokenizer)
    n_card, free_GB = probe_hardware()
    # 先以 bf16 载入测参数量(估显存用); 单卡/模型并行/LoRA 由 auto_parallel 定
    # 这里先 load 单卡(占位) → 数参数 → 定 mode → 重 load(模型并行/LoRA)
    # 简化: 先 load 到 npu:0 算 P, 再按 mode 处理
    print(f"[model] loading {arch} (bf16)...", flush=True)
    if MODE_FORCE in ("mp2",) or (MODE_FORCE=="auto"):
        # 先单卡 load 算参数量(占 2P), 再决定
        model=ModelCls.from_pretrained(MODEL, torch_dtype=torch.bfloat16, low_cpu_mem_usage=True).to("npu:0")
    else:
        model=ModelCls.from_pretrained(MODEL, torch_dtype=torch.bfloat16, low_cpu_mem_usage=True).to("npu:0")
    P_B=sum(p.numel() for p in model.parameters())/1e9
    mode, max_mem = auto_parallel(P_B, n_card, free_GB, MODE_FORCE)
    # 若 mode=mp2 → 重新以 device_map+max_memory load(切分); mode=lora → 后续 wrap LoRA
    if mode=="mp2":
        del model; torch.npu.empty_cache()
        model=ModelCls.from_pretrained(MODEL, torch_dtype=torch.bfloat16, device_map="auto", max_memory=max_mem, low_cpu_mem_usage=True)
    model.config.use_cache=False
    # 冻结 audio_tower+projector(按子模块路径, 勿用类名"Audio" #59)
    fr=0; tot=0
    for n,m in model.named_modules():
        if any(k in n for k in ("audio_tower","multi_modal_projector","audio_encoder","encoder.audio")):
            for p in m.parameters(recurse=True):
                if p.requires_grad: p.requires_grad_(False); fr+=p.numel()
    for p in model.parameters(): tot+=p.numel()
    P_train=(tot-fr)/1e9
    print(f"[freeze] frozen(audio_tower+projector)={fr/1e6:.0f}M, trainable={P_train:.3f}B/total {tot/1e9:.3f}B", flush=True)
    # LoRA 回退: 全量装不下时冻 base 训 q/k/v/o
    is_lora=(mode=="lora")
    if is_lora:
        try:
            from peft import LoraConfig, get_peft_model
            lcfg=LoraConfig(r=8,lora_alpha=16,lora_dropout=0.05,bias="none",target_modules=["q_proj","k_proj","v_proj","o_proj"],task_type="CAUSAL_LM")
            model=get_peft_model(model, lcfg)
            print(f"[lora] 回退(全量装不下): trainable={sum(p.numel() for p in model.parameters() if p.requires_grad)/1e6:.1f}M", flush=True)
        except Exception as e:
            print(f"[lora] peft 不可用({e}), 退单卡全量(可能 OOM)", flush=True); is_lora=False
    dev0=next(model.parameters()).device
    # LLM grad-ckpt
    for m in model.modules():
        tn=type(m).__name__
        if hasattr(m,"gradient_checkpointing_enable") and ("CausalLM" in tn or tn.endswith("Model") and "Qwen" in tn):
            try: m.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant":False})
            except Exception: pass
    try: model.enable_input_require_grads()
    except Exception: pass
    model.train()
    # 探测 forward 签名(#63 通用): Qwen2-Audio 接受 feature_attention_mask, MOSS 接受 audio_feature_lengths
    try: fwd_params=set(inspect.signature(model.forward).parameters.keys())
    except Exception: fwd_params=set()
    print(f"[forward] params含: {[k for k in ('feature_attention_mask','audio_feature_lengths','input_features') if k in fwd_params]}",flush=True)
    optim=torch.optim.AdamW([p for p in model.parameters() if p.requires_grad], lr=1e-5, betas=(0.9,0.95), weight_decay=0.01, eps=1e-8)
    # ---- 自动超参(对齐 hyperparam-selection.md) ----
    bs=BS if BS>0 else (1 if (not is_lora and P_train>=3) else 2)
    ga=GRAD_ACCUM if GRAD_ACCUM>0 else 1
    global_batch=bs*ga*n_card
    lr=float(LR_ENV) if LR_ENV!="0" else max(5e-6, min(5e-5, 1e-5*math.sqrt(max(1,global_batch/32))))
    warmup=WARMUP_ENV if WARMUP_ENV>0 else max(3, int(STEPS*0.1))
    print(f"[auto-hp] bs={bs} grad_accum={ga} n_card={n_card} global_batch={global_batch} → lr={lr:.1e} warmup={warmup}", flush=True)
    samples=load_samples()
    def lr_at(s):
        if s<warmup: return lr*(s+1)/warmup
        p=(s-warmup)/max(1,STEPS-warmup); return 0.5*lr*(1+math.cos(math.pi*p))
    log=[]; lp=os.path.join(LOG,"step_loss.jsonl"); open(lp,'w').close()
    print(f"[train] {STEPS} steps bs={bs} lr={lr:.1e} warmup={warmup} grad_accum={ga} mode={mode}{'(lora)' if is_lora else ''}", flush=True)
    print(f"{'step':>4} {'loss':>10} {'lr':>10} {'s/step':>7} {'ETA':>8}", flush=True)
    t0=time.time(); _lt=0.0; optim.zero_grad(set_to_none=False)
    for step in range(STEPS):
        idx=[(step*bs+i)%len(samples) for i in range(bs)]
        sb=[samples[j] for j in idx]
        try:
            ids,am,af,audio_kwargs,labels=build_inputs(proc, sb, dev0, audio_ids, fwd_params)
        except Exception as e:
            print(f"[skip step {step}] {type(e).__name__}: {str(e)[:60]}", flush=True); continue
        for g in optim.param_groups: g['lr']=lr_at(step)
        try:
            with torch.autocast(device_type="npu",dtype=torch.bfloat16):
                out=model(input_ids=ids, attention_mask=am, input_features=af, labels=labels, **audio_kwargs)  # #57/#63 通用 forward(audio mask kwarg 自动适配)
                loss=out.loss if hasattr(out,'loss') else out[0]
            (loss/ga).backward()
            if (step+1)%ga==0 or step==STEPS-1:
                torch.nn.utils.clip_grad_norm_([p for p in model.parameters() if p.requires_grad],1.0)
                optim.step(); optim.zero_grad(set_to_none=False)
        except torch.npu.OutOfMemoryError:
            # OOM 回退阶梯: 降 bs (#hyperparam-selection)
            if bs>1: bs=max(1,bs//2); print(f"[OOM] step{step} bs降→{bs}重试",flush=True); torch.npu.empty_cache(); optim.zero_grad(set_to_none=False); continue
            print(f"[OOM] step{step} bs=1仍OOM, 跳过",flush=True); torch.npu.empty_cache(); optim.zero_grad(set_to_none=False); continue
        ls=float(loss.detach().cpu()); el=time.time()-t0; sps=el/(step+1)
        log.append({"step":step,"loss":ls,"lr":lr_at(step),"elapsed_s":round(el,2),"s_per_step":round(sps,3)})
        with open(lp,'a') as f: f.write(json.dumps(log[-1])+'\n')
        if step%2==0 or step==STEPS-1:
            remain=(STEPS-1-step)*sps; eta=f"{remain/60:.1f}min" if remain>=60 else f"{remain:.0f}s"
            print(f"{step:>4} {ls:>10.5f} {lr_at(step):.2e} {sps:>7.3f} {eta:>8}", flush=True)
        now=time.time()
        if now-_lt>=30 or step==STEPS-1:
            _lt=now; remain=(STEPS-1-step)*sps if sps>0 else 0
            eta=f"{remain/60:.1f}min" if remain>=60 else f"{remain:.0f}s"
            try: subprocess.run([sys.executable,os.path.join(WS,"timing_table.py"),"--doing","7",str(round(el,0)),f"{step+1}/{STEPS}步 ETA{eta} loss={ls:.3f}"],check=False)
            except Exception: pass
    sd={k:(v.detach().to("cpu",dtype=torch.bfloat16) if v.is_floating_point() else v.detach().cpu()) for k,v in (model.state_dict() if not is_lora else model.state_dict()).items()}
    if is_lora:
        model.save_pretrained(os.path.join(OUT,"lora_adapter"))
    else:
        torch.save(sd, os.path.join(OUT,"cpt_audio_llm_state.pt"))
    f5=sum(r['loss'] for r in log[:5])/min(5,len(log)); l5=sum(r['loss'] for r in log[-5:])/min(5,len(log))
    s={"model":arch,"task":"audio-LLM CPT","mode":mode,"lora":is_lora,"parallel":("model-parallel(2卡)" if mode=="mp2" else "single"),"optim":"AdamW",
       "precision":"bf16 master+bf16 autocast","steps":STEPS,"bs":bs,"lr":round(lr,7),"warmup":warmup,"grad_accum":ga,"global_batch":global_batch,
       "n_trainable_B":round(P_train,3),"first5":round(f5,5),"last5":round(l5,5),"min":round(min(r['loss'] for r in log),5),
       "final":round(log[-1]['loss'],5),"delta":round(f5-l5,5),"total_time_s":round(time.time()-t0,2)}
    json.dump(s,open(os.path.join(OUT,"train_summary.json"),"w"),ensure_ascii=False,indent=2)
    json.dump(log,open(os.path.join(OUT,"losses.json"),"w"),ensure_ascii=False,indent=2)
    print("\n[done]"+json.dumps(s,ensure_ascii=False,indent=2), flush=True)

if __name__=="__main__": main()
