#!/usr/bin/env python
# eval_diffusion.py.tmpl — 扩散生成式 CPT 前后评估
# ① 量化: base vs CPT 在 held-out latent 上 velocity MSE(固定σ)
# ② 定性: CPT backbone 采样 → VAE 解码 → 存 mp4(imageio-ffmpeg)
import os, json, time
os.environ.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD","0")
os.environ.setdefault("TASK_QUEUE_ENABLE","1")
os.environ.setdefault("PYTORCH_NPU_ALLOC_CONF","expandable_segments:True")
import torch, torch_npu, numpy as np
torch.npu.set_device(0); DEV="npu:0"
from diffusers import WanTransformer3DModel, AutoencoderKLWan  # Wan; 其它模型换对应类

WS=os.environ["WS_DIR"]; MODEL_DIR=os.environ["MODEL_DIR"]
BK_DIR=os.environ.get("BACKBONE_DIR","transformer"); VAE_DIR=os.environ.get("VAE_DIR","vae")
OUT=f"{WS}/outputs"; CKPT=f"{OUT}/dit_cpt_state.pt"
SIGMA=float(os.environ.get("EVAL_SIGMA","0.5"))

def load_backbone(state=None):
    dit=WanTransformer3DModel.from_pretrained(f"{MODEL_DIR}/{BK_DIR}", torch_dtype=torch.bfloat16).to(DEV)
    if state is not None:
        dit.load_state_dict(torch.load(state,map_location=DEV,weights_only=False), strict=False)
    dit.eval(); return dit

def backbone_fwd(dit, noisy, t, emb):  # #51 兼容
    out=dit(hidden_states=noisy, timestep=t, encoder_hidden_states=emb, return_dict=True)
    if isinstance(out,dict): return out["sample"]
    return out.sample if hasattr(out,"sample") else out

def vel_mse(dit, latents, embs, n=5):
    tot=0.0; c=0
    with torch.no_grad():
        for i in range(min(n,len(latents))):
            lat=latents[i].to(DEV).to(torch.bfloat16); emb=embs[i].to(DEV).to(torch.bfloat16)
            noise=torch.randn_like(lat); noisy=(1-SIGMA)*lat+SIGMA*noise; target=noise-lat
            t=torch.tensor([SIGMA*1000],device=DEV)
            pred=backbone_fwd(dit,noisy,t,emb)
            tot+=float(torch.nn.functional.mse_loss(pred.float(),target.float()).cpu()); c+=1
    return tot/max(1,c)

def gen_sample(dit, vae, n_steps=20):
    lat=torch.randn(1,16,6,60,104,device=DEV,dtype=torch.bfloat16)  # shape 据 prepare 阶段 latent 调
    emb=torch.zeros(1,77,4096,device=DEV,dtype=torch.bfloat16)
    with torch.no_grad():
        for s in range(n_steps):
            tv=(n_steps-1-s)/n_steps; t=torch.tensor([tv*1000],device=DEV)
            v=backbone_fwd(dit,lat,t,emb); lat=lat+(1.0/n_steps)*v  # Euler t:1→0
        vid=vae.decode(lat).sample
    return vid

def save_video(vid, path_mp4, fps=8):
    frames=((vid[0].clamp(-1,1).float().cpu()+1)/2*255).permute(0,2,3,1).numpy().astype("uint8")  # [T,H,W,3]
    np.save(path_mp4.replace(".mp4","_frames.npy"), frames)
    import imageio_ffmpeg, subprocess
    h,w=frames.shape[1],frames.shape[2]
    p=subprocess.Popen([imageio_ffmpeg.get_ffmpeg_exe(),"-y","-f","rawvideo","-pix_fmt","rgb24","-s",f"{w}x{h}","-r",str(fps),"-i","-","-pix_fmt","yuv420p",path_mp4],stdin=subprocess.PIPE)
    p.stdin.write(frames.tobytes()); p.stdin.close(); p.wait()

def main():
    data=torch.load(f"{OUT}/video_latents.pt",weights_only=False)
    latents=data["latents"]; embs=data["embs"]
    n_tr=int(len(latents)*0.8); held_lat=latents[n_tr:]; held_emb=embs[n_tr:]
    print(f"[eval] held-out={len(held_lat)}",flush=True)
    res={}
    for tag in ["base","cpt"]:
        dit=load_backbone(CKPT if tag=="cpt" else None)
        m=vel_mse(dit,held_lat,held_emb); res[tag]=round(m,5)
        print(f"  [{tag}] velocity MSE(σ={SIGMA}) = {m:.5f}",flush=True)
        del dit; torch.npu.empty_cache()
    d=round(res["cpt"]-res["base"],5)
    fin={"base":res["base"],"cpt":res["cpt"],"delta_cpt_minus_base":d,"note":"MSE delta<0=CPT velocity 预测更准(训练有效)"}
    json.dump(fin,open(f"{OUT}/eval_results.json","w"),ensure_ascii=False,indent=2)
    print(json.dumps(fin,ensure_ascii=False,indent=2),flush=True)
    print("\n[gen] CPT 采样生成视频...",flush=True)
    t0=time.time()
    try:
        dit=load_backbone(CKPT); vae=AutoencoderKLWan.from_pretrained(f"{MODEL_DIR}/{VAE_DIR}",torch_dtype=torch.bfloat16).to(DEV).eval()
        vid=gen_sample(dit,vae); save_video(vid,f"{OUT}/sample_cpt.mp4")
        print(f"[gen] saved sample_cpt.mp4 {vid.shape} {time.time()-t0:.1f}s",flush=True)
    except Exception as e:
        print(f"[gen] 失败: {type(e).__name__} {str(e)[:150]}",flush=True)
    print("EVAL_DONE",flush=True)

if __name__=="__main__": main()
