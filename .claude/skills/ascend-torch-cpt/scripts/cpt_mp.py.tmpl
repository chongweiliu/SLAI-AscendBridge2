#!/usr/bin/env python
# -*- coding: utf-8 -*-
# cpt_mp.py.tmpl — 昇腾 NPU 朴素模型并行 CPT（device_map="auto" 拆多卡，无 all-gather）
# 何时用: 卡间互联慢（RoCE 未配 / HCCL 走慢速 PCIe，见 references/pitfalls.md #23），
#         大模型单卡装不下优化器状态，且 FSDP2 会通信-bound 时。实测 12B/4卡 8× 加速。
# 单进程即可（无需 torchrun）：.to(device) 可微分，autograd 自动跨卡回传梯度。
# 关键（踩坑已规避，见 references/pitfalls.md）:
#  - 必须 fp32 主权重（bf16 权重 + 小 lr 更新被精度吞掉，见 #25）
#  - optimizer 用默认 torch.optim.AdamW（foreach=True 对多 device 参数可能不兼容，用 False）
#  - 输入放 model.device（embed 所在卡）
#  - 评估用 bf16 单卡加载（fp32 会 OOM，见 #31）
# 规范（见 SKILL.md 核心原则）：
#  - 只跑 NPU（禁止回退 CPU）；后台运行每 ≤2-3 分钟心跳输出（下面用时间基准打印）
import os, json, math, time
import torch, torch_npu  # noqa: F401  必须，autoload=0 时手动注册
from transformers import AutoModelForCausalLM

MODEL_DIR = os.environ["MODEL_DIR"]; WS_DIR = os.environ["WS_DIR"]
SEQ_LEN = int(os.environ.get("SEQ_LEN", "512"))
BATCH_SIZE = int(os.environ.get("BATCH_SIZE", "1"))
NUM_STEPS = int(os.environ.get("NUM_STEPS", "100"))
LR = float(os.environ.get("LR", "5e-6"))
WARMUP = int(os.environ.get("WARMUP", "10"))
WD = float(os.environ.get("WD", "0.01"))
GRAD_CLIP = float(os.environ.get("GRAD_CLIP", "1.0"))
SEED = int(os.environ.get("SEED", "42"))
RESUME = os.environ.get("RESUME", "0") == "1"          # 断点续训总开关（默认关闭）
EST_STEP_S = float(os.environ.get("EST_STEP_S", "10"))   # 预估每步秒数（估总时长→保存间隔）
CKPT_MIN_INTERVAL_S = float(os.environ.get("CKPT_MIN_INTERVAL_S", "900"))  # 周期保存最小间隔(s)，默认15min
CKPT_MAX_SAVES = int(os.environ.get("CKPT_MAX_SAVES", "5"))                # 训练期间最多保存次数
OUT = os.path.join(WS_DIR, "outputs"); LOG = os.path.join(WS_DIR, "logs")
os.makedirs(OUT, exist_ok=True); os.makedirs(LOG, exist_ok=True)

torch.manual_seed(SEED)


def lr_at(s, lr, warmup, total):
    if s < warmup:
        return lr * (s + 1) / warmup
    p = (s - warmup) / max(1, total - warmup)
    return 0.5 * lr * (1 + math.cos(math.pi * p))


def _save_resume_ckpt(model, optim, step, ck_path):
    """断点续训 ckpt：模型 fp32 权重(cpu) + 优化器 m/v(cpu) + step。"""
    model_sd = {n: p.detach().cpu() for n, p in model.named_parameters()}
    opt_sd = optim.state_dict()
    for st in opt_sd["state"].values():
        for k, v in list(st.items()):
            if isinstance(v, torch.Tensor):
                st[k] = v.cpu()
    torch.save({"step": step, "model": model_sd, "optimizer": opt_sd}, ck_path)


def _load_resume_ckpt(model, optim, ck_path):
    """恢复：权重 load_state_dict 自动 copy 回各 device；优化器 state 手动搬回各 param device。"""
    ck = torch.load(ck_path, map_location="cpu", weights_only=False)  # 见 pitfalls #21
    model.load_state_dict(ck["model"], strict=False)
    optim.load_state_dict(ck["optimizer"])
    for pg in optim.param_groups:
        for p in pg["params"]:
            st = optim.state[p]
            for k, v in st.items():
                if isinstance(v, torch.Tensor):
                    st[k] = v.to(p.device)
    return ck["step"]


def main():
    t_start = time.time()
    print("[load] fp32 + device_map=auto 拆多卡 ...", flush=True)
    model = AutoModelForCausalLM.from_pretrained(
        MODEL_DIR, torch_dtype=torch.float32, trust_remote_code=True,
        low_cpu_mem_usage=True, device_map="auto")   # 自动拆到可见 NPU 卡
    model.train(); model.config.use_cache = False
    try:
        model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
    except TypeError:
        model.gradient_checkpointing_enable()

    P = sum(p.numel() for p in model.parameters())
    dev_of = {}
    for n, p in model.named_parameters():
        dev_of[str(p.device)] = dev_of.get(str(p.device), 0) + p.numel()
    print(f"[model] {P/1e9:.3f}B params, 设备分布: "
          + ", ".join(f"{d}:{c/1e9:.1f}B" for d, c in dev_of.items()), flush=True)

    optim = torch.optim.AdamW(model.parameters(), lr=LR, betas=(0.9, 0.95), weight_decay=WD, eps=1e-8)

    # 断点续训：RESUME=1 且存在 ckpt_latest.pt 时从断点恢复
    ck_path = os.path.join(OUT, "ckpt_latest.pt")
    start_step = 0
    if RESUME and os.path.exists(ck_path):
        start_step = _load_resume_ckpt(model, optim, ck_path)
        print(f"[resume] from step {start_step}", flush=True)

    x = torch.load(os.path.join(OUT, "input_ids.pt"))
    N = x.shape[0]
    rng = torch.Generator().manual_seed(SEED)
    order = torch.randperm(N, generator=rng).tolist()
    inp_dev = model.device  # embed 所在卡

    lp = os.path.join(LOG, "step_loss_mp.jsonl")
    open(lp, "a" if RESUME else "w").close()
    print(f"[train] {NUM_STEPS} steps bs={BATCH_SIZE} seq={SEQ_LEN} lr={LR} (model-parallel)", flush=True)

    log = []
    t0 = time.time()
    last_print = 0.0
    last_save_t = t0
    _save_interval_s = max(CKPT_MIN_INTERVAL_S, NUM_STEPS * EST_STEP_S / CKPT_MAX_SAVES)  # 周期保存间隔（时间基准）
    for step in range(start_step, NUM_STEPS):
        bi = step % (N // BATCH_SIZE)
        bidx = order[bi * BATCH_SIZE:(bi + 1) * BATCH_SIZE]
        batch = x[bidx].to(inp_dev)
        attn = torch.ones_like(batch)
        for g in optim.param_groups:
            g["lr"] = lr_at(step, LR, WARMUP, NUM_STEPS)

        out = model(input_ids=batch, attention_mask=attn, labels=batch)
        loss = out.loss
        loss.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), GRAD_CLIP)
        optim.step()
        optim.zero_grad(set_to_none=False)

        ls = float(loss.detach().cpu())
        el = time.time() - t0
        sps = el / (step - start_step + 1)
        log.append({"step": step, "loss": ls, "lr": lr_at(step, LR, WARMUP, NUM_STEPS),
                    "s_per_step": round(sps, 3), "tok_per_s": round(BATCH_SIZE * SEQ_LEN / sps, 1)})
        with open(lp, "a") as f:
            f.write(json.dumps(log[-1]) + "\n")
        # 心跳输出：按时间基准（≤2-3 分钟必打印），而非固定步数（慢步速下固定步数会超时）
        if time.time() - last_print >= 120 or step == NUM_STEPS - 1:
            print(f"{step:>4} loss={ls:>9.5f} lr={lr_at(step,LR,WARMUP,NUM_STEPS):.2e} "
                  f"{sps:>7.2f}s/step {BATCH_SIZE*SEQ_LEN/sps:>7.1f}tok/s", flush=True)
            last_print = time.time()
        # 周期保存 resume ckpt（仅 RESUME=1 时，按时间基准：≤5 次、间隔 ≥15min）
        if RESUME and (time.time() - last_save_t >= _save_interval_s) and step < NUM_STEPS - 1:
            _save_resume_ckpt(model, optim, step + 1, ck_path)
            last_save_t = time.time()

    # 保存 CPT 权重（fp32 → bf16 减半，评估用）
    sd = {n: p.detach().cpu().to(torch.bfloat16) for n, p in model.named_parameters()}
    torch.save(sd, os.path.join(OUT, "cpt_model_state.pt"))
    # 保存最终 resume ckpt（供后续续训；与 RESUME 开关无关，训练结束总是存）
    _save_resume_ckpt(model, optim, NUM_STEPS, ck_path)
    f5 = sum(xx["loss"] for xx in log[:5]) / 5
    l5 = sum(xx["loss"] for xx in log[-5:]) / 5
    sm = {"parallel": "model-parallel device_map auto", "batch_size": BATCH_SIZE,
          "seq_len": SEQ_LEN, "steps": NUM_STEPS, "lr": LR, "optimizer": "AdamW(NPU fp32)",
          "precision": "fp32 params + fp32 AdamW", "n_params_B": round(P / 1e9, 3),
          "first5": round(f5, 5), "last5": round(l5, 5),
          "min": round(min(xx["loss"] for xx in log), 5), "final": round(log[-1]["loss"], 5),
          "delta": round(f5 - l5, 5), "total_time_s": round(time.time() - t_start, 2)}
    json.dump(sm, open(os.path.join(OUT, "train_summary.json"), "w"), ensure_ascii=False, indent=2)
    json.dump(log, open(os.path.join(OUT, "losses.json"), "w"), ensure_ascii=False, indent=2)
    print("\n[done] " + json.dumps(sm, ensure_ascii=False, indent=2), flush=True)


if __name__ == "__main__":
    main()
