#!/usr/bin/env python
# -*- coding: utf-8 -*-
# cpt_seq2seq.py.tmpl — 昇腾 NPU Seq2Seq 继续预训练（NLLB/M2M100, T5, BART, MarianMT）
# 单卡: python cpt_seq2seq.py
# DDP : python -m torch.distributed.run --nproc_per_node=N cpt_seq2seq.py
# 数据: prepare_data_seq2seq.py.tmpl 产出的 input_ids.pt {src:[...], tgt:[...]}（已 tokenize 的 id 对）
# 损失: Seq2Seq 翻译 CE（labels pad→-100 不算 loss）
# 踩坑已规避: autoload=0, set_to_none=False, gradient_as_bucket_view=False, expandable_segments, autocast, grad-ckpt
import os, json, math, time, random, sys, subprocess
import torch
import torch_npu  # noqa: F401
try:
    import torch.distributed as dist
    from torch.nn.parallel import DistributedDataParallel as DDP
    _DDP=True
except Exception: _DDP=False
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer
from torch_npu.optim import NpuFusedAdamW

MODEL_DIR=os.environ["MODEL_DIR"]; WS_DIR=os.environ["WS_DIR"]
SEQ_LEN=int(os.environ.get("SEQ_LEN","512"))
BATCH_SIZE=int(os.environ.get("BATCH_SIZE","16"))
NUM_STEPS=int(os.environ.get("NUM_STEPS","200"))
LR=float(os.environ.get("LR","1e-5"))
WARMUP=int(os.environ.get("WARMUP","20"))
WD=float(os.environ.get("WD","0.01")); GRAD_CLIP=1.0
GRAD_ACCUM=int(os.environ.get("GRAD_ACCUM","1"))
SRC_LANG=os.environ.get("SRC_LANG","")    # 源语言(如 eng_Latn), NLLB 必填, T5/BART 可空
TGT_LANG=os.environ.get("TGT_LANG","")    # 目标语言(如 zho_Hans), NLLB 必填
RESUME=os.environ.get("RESUME","0")=="1"
EST_STEP_S=float(os.environ.get("EST_STEP_S","5"))
CKPT_MIN_INTERVAL_S=float(os.environ.get("CKPT_MIN_INTERVAL_S","900"))
CKPT_MAX_SAVES=int(os.environ.get("CKPT_MAX_SAVES","5"))
SEED=int(os.environ.get("SEED","42"))
LOG=os.path.join(WS_DIR,'logs'); OUT=os.path.join(WS_DIR,'outputs')
os.makedirs(LOG,exist_ok=True); os.makedirs(OUT,exist_ok=True)

def is_ddp(): return _DDP and 'RANK' in os.environ

def setup_dist():
    r=int(os.environ['RANK']); w=int(os.environ['WORLD_SIZE']); lr=int(os.environ['LOCAL_RANK'])
    dist.init_process_group('hccl',rank=r,world_size=w); torch.npu.set_device(lr)
    return r,w,lr

def load_model(device):
    model=AutoModelForSeq2SeqLM.from_pretrained(MODEL_DIR, torch_dtype=torch.float32, trust_remote_code=True)
    model=model.to(device); model.train()
    try: model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant":False})
    except TypeError: model.gradient_checkpointing_enable()
    return model

def pad_batch(seqs, pad_id):
    """把变长 id list pad 到等长 tensor"""
    ml=max(len(s) for s in seqs)
    ids=torch.full((len(seqs),ml),pad_id,dtype=torch.long)
    mask=torch.zeros((len(seqs),ml),dtype=torch.long)
    for i,s in enumerate(seqs):
        ids[i,:len(s)]=torch.tensor(s); mask[i,:len(s)]=1
    return ids,mask

def main():
    rank=world=local=0
    if is_ddp(): rank,world,local=setup_dist()
    else: torch.npu.set_device(0)
    device=f"npu:{local}"
    # tokenizer: NLLB 需 src_lang/tgt_lang, T5/BART 可忽略
    kw={}
    if SRC_LANG: kw['src_lang']=SRC_LANG
    if TGT_LANG: kw['tgt_lang']=TGT_LANG
    tok=AutoTokenizer.from_pretrained(MODEL_DIR, trust_remote_code=True, **kw)
    if tok.pad_token is None: tok.pad_token=tok.unk_token or '[PAD]'
    pad_id=tok.pad_token_id
    model=load_model(device)
    nP=sum(p.numel() for p in model.parameters())
    if is_ddp():
        model=DDP(model,device_ids=[local],find_unused_parameters=True,gradient_as_bucket_view=False)
    if rank==0: print(f"[model] {nP/1e6:.1f}M dev={device} ddp={is_ddp()} world={max(1,world)} optim=NpuFusedAdamW seq2seq src={SRC_LANG} tgt={TGT_LANG}",flush=True)

    optim=NpuFusedAdamW(model.parameters(),lr=LR,betas=(0.9,0.95),weight_decay=WD,eps=1e-8)
    data=torch.load(os.path.join(OUT,'input_ids.pt'),weights_only=False)
    src_list=data['src']; tgt_list=data['tgt']; N=len(src_list)
    if is_ddp():
        s=torch.utils.data.distributed.DistributedSampler(list(range(N)),num_replicas=world,rank=rank,shuffle=True,seed=SEED,drop_last=True); s.set_epoch(0); idxs=list(s)
    else:
        rng=random.Random(SEED); idxs=list(range(N)); rng.shuffle(idxs)
    nb=max(1,N//BATCH_SIZE)

    def lr_at(s):
        if s<WARMUP: return LR*(s+1)/WARMUP
        p=(s-WARMUP)/max(1,NUM_STEPS-WARMUP); return 0.5*LR*(1+math.cos(math.pi*p))

    ck_path=os.path.join(OUT,"ckpt_latest.pt"); start_step=0
    if RESUME and os.path.exists(ck_path):
        ck=torch.load(ck_path,map_location="cpu",weights_only=False)
        m=model.module if is_ddp() else model
        m.load_state_dict(ck["model"],strict=False); optim.load_state_dict(ck["optimizer"]); start_step=ck["step"]
        if rank==0: print(f"[resume] from step {start_step}",flush=True)

    log=[]; lp=os.path.join(LOG,f"step_loss_s2s{'_ddp' if is_ddp() else ''}.jsonl")
    if rank==0:
        open(lp,'a' if RESUME else 'w').close()
        print(f"[train] {NUM_STEPS} steps bs/rank={BATCH_SIZE} global={BATCH_SIZE*max(1,world)} seq={SEQ_LEN} lr={LR} grad_accum={GRAD_ACCUM}",flush=True)
        print(f"{'step':>4} {'loss':>10} {'lr':>10} {'s/step':>7} {'tok/s':>8} {'ETA':>8}",flush=True)
    t0=time.time(); last_save_t=t0; _last_table_t=0.0
    _save_interval_s=max(CKPT_MIN_INTERVAL_S, NUM_STEPS*EST_STEP_S/CKPT_MAX_SAVES)
    for step in range(start_step,NUM_STEPS):
        bi=step%nb; bidx=idxs[bi*BATCH_SIZE:(bi+1)*BATCH_SIZE]
        src_batch=[src_list[i] for i in bidx]; tgt_batch=[tgt_list[i] for i in bidx]
        inp,imask=pad_batch(src_batch,pad_id); lbl,_=pad_batch(tgt_batch,pad_id)
        inp=inp.to(device); imask=imask.to(device); lbl=lbl.to(device)
        lbl_masked=lbl.clone(); lbl_masked[lbl_masked==pad_id]=-100   # pad 位置不算 loss
        lr=lr_at(step)
        for g in optim.param_groups: g['lr']=lr
        optim.zero_grad(set_to_none=False)
        with torch.autocast(device_type="npu",dtype=torch.bfloat16):
            out=model(input_ids=inp,attention_mask=imask,labels=lbl_masked); loss=out.loss
        (loss/GRAD_ACCUM).backward()
        if (step+1)%GRAD_ACCUM==0 or step==NUM_STEPS-1:
            torch.nn.utils.clip_grad_norm_(model.parameters(),GRAD_CLIP); optim.step()
        ls=float(loss.detach().cpu())
        if is_ddp():
            t=torch.tensor([ls],device=device,dtype=torch.float32); dist.all_reduce(t,op=dist.ReduceOp.AVG); ls=float(t.cpu())
        el=time.time()-t0; sps=el/(step-start_step+1); tps=BATCH_SIZE*max(1,world)*SEQ_LEN*GRAD_ACCUM/sps if sps>0 else 0
        log.append({"step":step,"loss":ls,"lr":lr,"elapsed_s":round(el,2),"s_per_step":round(sps,3)})
        if rank==0:
            with open(lp,'a') as f: f.write(json.dumps(log[-1])+'\n')
            if step%5==0 or step==NUM_STEPS-1:
                remain=(NUM_STEPS-1-step)*sps; eta=f"{remain/60:.1f}min" if remain>=60 else f"{remain:.0f}s"
                print(f"{step:>4} {ls:>10.5f} {lr:.2e} {sps:>7.3f} {tps:>8.0f} {eta:>8}",flush=True)
            now=time.time()
            if now-_last_table_t>=30 or step==NUM_STEPS-1:
                _last_table_t=now
                remain=(NUM_STEPS-1-step)*sps if sps>0 else 0
                eta=f"{remain/60:.1f}min" if remain>=60 else f"{remain:.0f}s"
                try: subprocess.run([sys.executable,os.path.join(WS_DIR,"timing_table.py"),"--doing","7",str(round(el,0)),f"{step+1}/{NUM_STEPS}步 ETA{eta} loss={ls:.3f}"],check=False)
                except Exception: pass
        if RESUME and rank==0 and (time.time()-last_save_t>=_save_interval_s) and step<NUM_STEPS-1:
            m=model.module if is_ddp() else model
            torch.save({"step":step+1,"model":m.state_dict(),"optimizer":optim.state_dict()},ck_path); last_save_t=time.time()
    if rank==0:
        m=model.module if is_ddp() else model
        torch.save(m.state_dict(),os.path.join(OUT,'cpt_model_state.pt'))
        torch.save({"step":NUM_STEPS,"model":m.state_dict(),"optimizer":optim.state_dict()},ck_path)
        f5=sum(r['loss'] for r in log[:5])/5; l5=sum(r['loss'] for r in log[-5:])/5
        s={"parallel":"ddp" if is_ddp() else "single","world_size":max(1,world),"global_batch":BATCH_SIZE*max(1,world),
           "batch_per_rank":BATCH_SIZE,"seq_len":SEQ_LEN,"steps":NUM_STEPS,"lr":LR,"warmup":WARMUP,"wd":WD,
           "grad_clip":GRAD_CLIP,"optim":"NpuFusedAdamW","precision":"fp32+bf16 autocast","grad_ckpt":True,
           "loss":"Seq2Seq translation CE","src_lang":SRC_LANG,"tgt_lang":TGT_LANG,
           "n_params_M":round(nP/1e6,2),"first5":round(f5,5),"last5":round(l5,5),
           "min":round(min(r['loss'] for r in log),5),"final":round(log[-1]['loss'],5),
           "delta":round(f5-l5,5),"total_time_s":round(time.time()-t0,2)}
        json.dump(s,open(os.path.join(OUT,'train_summary.json'),'w'),ensure_ascii=False,indent=2)
        json.dump(log,open(os.path.join(OUT,'losses.json'),'w'),ensure_ascii=False,indent=2)
        print("\n[done]"+json.dumps(s,ensure_ascii=False,indent=2),flush=True)
    if is_ddp(): dist.barrier(); dist.destroy_process_group()

if __name__=='__main__': main()
