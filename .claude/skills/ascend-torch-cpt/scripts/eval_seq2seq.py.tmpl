#!/usr/bin/env python
# -*- coding: utf-8 -*-
# eval_seq2seq.py.tmpl — Seq2Seq 模型 base vs CPT 域内评估
# 指标: 翻译 CE loss / PPL
# held-out: VAL_FILE 独立验证集(优先) 或从 DATA_FILE held-out split
# 适用: NLLB/M2M100, T5, BART, MarianMT
import os, json, random, math, torch, torch_npu  # noqa: F401
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer

MODEL_DIR=os.environ["MODEL_DIR"]; DATA_FILE=os.environ["DATA_FILE"]; WS_DIR=os.environ["WS_DIR"]
OUT=os.path.join(WS_DIR,"outputs"); CKPT=os.path.join(OUT,"cpt_model_state.pt")
DEVICE="npu:0"; SEED=int(os.environ.get("SEED","42")); N_VAL=int(os.environ.get("N_VAL","10"))
VAL_FILE=os.environ.get("VAL_FILE","")
TRAIN_RATIO=float(os.environ.get("RATIO","1.0"))
SRC_LANG=os.environ.get("SRC_LANG",""); TGT_LANG=os.environ.get("TGT_LANG","")
SRC_KEY=os.environ.get("SRC_KEY","src"); TGT_KEY=os.environ.get("TGT_KEY","tgt")

def load_model(src):
    model=AutoModelForSeq2SeqLM.from_pretrained(MODEL_DIR, torch_dtype=torch.float32, trust_remote_code=True)
    if src=='cpt' and os.path.exists(CKPT):
        sd=torch.load(CKPT,map_location=DEVICE,weights_only=False)
        model.load_state_dict(sd,strict=False)
    model=model.to(DEVICE); model.eval()
    return model

def main():
    torch.npu.set_device(0)
    kw={}
    if SRC_LANG: kw['src_lang']=SRC_LANG
    if TGT_LANG: kw['tgt_lang']=TGT_LANG
    tok=AutoTokenizer.from_pretrained(MODEL_DIR, trust_remote_code=True, **kw)
    if tok.pad_token is None: tok.pad_token=tok.unk_token or '[PAD]'
    pad_id=tok.pad_token_id
    if VAL_FILE and os.path.exists(VAL_FILE):
        val=[json.loads(l) for l in open(VAL_FILE,encoding='utf-8') if l.strip()][:N_VAL]
        print(f"[val] VAL_FILE 取 {len(val)} 条(独立验证集)",flush=True)
    else:
        recs=[json.loads(l) for l in open(DATA_FILE,encoding='utf-8') if l.strip()]
        total=len(recs); n_tr=int(total*TRAIN_RATIO)
        rng=random.Random(SEED); idx=list(range(total)); rng.shuffle(idx)
        held=idx[n_tr:]; val=[recs[i] for i in held[:N_VAL]]
        print(f"[val] held_out={len(held)} 取 {len(val)} 条",flush=True)
    json.dump(val,open(os.path.join(OUT,'val_samples.json'),'w'),ensure_ascii=False,indent=2)
    res={"base":[],"cpt":[]}; summ={}
    for tag in ["base","cpt"]:
        print(f"\n===== eval {tag} =====",flush=True)
        m=load_model(tag)
        tot_loss=tot_n=0
        for i,rec in enumerate(val):
            src=rec.get(SRC_KEY) or rec.get('en') or rec.get('source') or ''
            tgt=rec.get(TGT_KEY) or rec.get('zh') or rec.get('target') or ''
            if not src or not tgt: continue
            inp=tok(src,truncation=True,max_length=512,return_tensors='pt')['input_ids'].to(DEVICE)
            lbl=tok(text_target=tgt,truncation=True,max_length=512,return_tensors='pt')['input_ids'].to(DEVICE)
            lbl_masked=lbl.clone(); lbl_masked[lbl_masked==pad_id]=-100
            with torch.no_grad(),torch.autocast(device_type="npu",dtype=torch.bfloat16):
                out=m(input_ids=inp,labels=lbl_masked)
            ls=float(out.loss)
            if not math.isnan(ls): tot_loss+=ls; tot_n+=1
            res[tag].append({"i":i,"loss":ls,"ppl":math.exp(min(ls,20)) if not math.isnan(ls) else float('nan')})
            print(f"  [{tag}] v{i}: loss={ls:.4f} ppl={math.exp(min(ls,20)) if not math.isnan(ls) else 'NaN':.2f}",flush=True)
        n=max(1,tot_n)
        ml=tot_loss/n
        summ[tag]={"mean_loss":round(ml,5),"mean_ppl":round(math.exp(min(ml,20)),2),"n_valid":tot_n}
        del m; torch.npu.empty_cache()
    b,c=summ["base"],summ["cpt"]
    delta={k:round(c[k]-b[k],5) for k in b if k!='n_valid'}
    fin={"base":b,"cpt":c,"delta_cpt_minus_base":delta,"note":"loss/ppl delta<0 改善; NaN样本已排除"}
    json.dump({"summary":fin,"per_sample":res},open(os.path.join(OUT,'eval_results.json'),'w'),ensure_ascii=False,indent=2)
    print("\n===== 汇总 =====\n"+json.dumps(fin,ensure_ascii=False,indent=2),flush=True)

if __name__=='__main__': main()
