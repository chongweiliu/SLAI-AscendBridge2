#!/usr/bin/env python
# cpt_diffusion.py.tmpl — 扩散生成式(文生视频/文生图) DiT/U-Net 流匹配 CPT
# 读缓存的 latent+text emb → 流匹配 velocity → MSE loss → NpuFusedAdamW
# fp32 主权重 + bf16 autocast + 梯度检查点; 全程 NPU(规避 cgroup #44/#46)
# 占位: MODEL_DIR, WS_DIR, BACKBONE_DIR 由 run_env.sh 注入; NUM_STEPS/LR/WARMUP 可 env 覆盖
import os, json, math, time, sys, subprocess, random
os.environ.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD","0")
os.environ.setdefault("TASK_QUEUE_ENABLE","1")
os.environ.setdefault("PYTORCH_NPU_ALLOC_CONF","expandable_segments:True")
import torch, torch_npu
torch.npu.set_device(0); DEV="npu:0"
from diffusers import WanTransformer3DModel  # Wan; 其它模型换对应类(见 generative-diffusion-cpt.md)
from torch_npu.optim import NpuFusedAdamW

MODEL_DIR=os.environ["MODEL_DIR"]; WS_DIR=os.environ["WS_DIR"]
BK_DIR=os.environ.get("BACKBONE_DIR","transformer")
LOG=os.path.join(WS_DIR,"logs"); OUT=os.path.join(WS_DIR,"outputs")
os.makedirs(LOG,exist_ok=True); os.makedirs(OUT,exist_ok=True)
NUM_STEPS=int(os.environ.get("NUM_STEPS","50")); LR=float(os.environ.get("LR","1e-5"))
WARMUP=int(os.environ.get("WARMUP","5")); SEED=int(os.environ.get("SEED","42"))
GRAD_CLIP=float(os.environ.get("GRAD_CLIP","1.0"))
torch.manual_seed(SEED); random.seed(SEED)

def load_backbone():
    dit=WanTransformer3DModel.from_pretrained(f"{MODEL_DIR}/{BK_DIR}", torch_dtype=torch.float32).to(DEV)
    dit.train()
    try: dit.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant":False})
    except Exception as e: print(f"[gc] {e}",flush=True)
    return dit

def backbone_forward(dit, noisy, t, emb):
    """返回兼容 tensor|dict|dataclass(#51)，绝不 out[0]。"""
    out=dit(hidden_states=noisy, timestep=t, encoder_hidden_states=emb, return_dict=True)
    if isinstance(out,dict): return out.get("sample",out)
    return out.sample if hasattr(out,"sample") else out

def main():
    data=torch.load(f"{OUT}/video_latents.pt", weights_only=False)
    latents=data["latents"]; embs=data["embs"]; N=len(latents)
    print(f"[data] {N} cached samples",flush=True)
    dit=load_backbone(); nP=sum(p.numel() for p in dit.parameters())
    print(f"[model] backbone {nP/1e9:.3f}B on {DEV} optim=NpuFusedAdamW",flush=True)
    optim=NpuFusedAdamW(dit.parameters(), lr=LR, betas=(0.9,0.95), weight_decay=0.01, eps=1e-8)
    def lr_at(s):
        if s<WARMUP: return LR*(s+1)/WARMUP
        p=(s-WARMUP)/max(1,NUM_STEPS-WARMUP); return 0.5*LR*(1+math.cos(math.pi*p))
    log=[]; lp=os.path.join(LOG,"step_loss.jsonl"); open(lp,'w').close()
    print(f"{'step':>4} {'loss':>10} {'lr':>10} {'s/step':>7} {'ETA':>8}",flush=True)
    t0=time.time(); _lt=0.0
    for step in range(NUM_STEPS):
        i=step%N
        lat=latents[i].to(DEV).to(torch.float32); emb=embs[i].to(DEV).to(torch.bfloat16)
        sigma=torch.rand(lat.shape[0],device=DEV,dtype=torch.float32).view(-1,*[1]*(lat.dim()-1))
        noise=torch.randn_like(lat); noisy=(1-sigma)*lat+sigma*noise
        target=noise-lat  # velocity (flow matching)
        lr=lr_at(step)
        for g in optim.param_groups: g['lr']=lr
        optim.zero_grad(set_to_none=False)
        with torch.autocast(device_type="npu",dtype=torch.bfloat16):
            t=torch.tensor([float(sigma.flatten()[0])*1000],device=DEV)
            pred=backbone_forward(dit, noisy.to(torch.bfloat16), t, emb)
            loss=torch.nn.functional.mse_loss(pred.float(),target.float())
        loss.backward(); torch.nn.utils.clip_grad_norm_(dit.parameters(),GRAD_CLIP); optim.step()
        ls=float(loss.detach().cpu()); el=time.time()-t0; sps=el/(step+1)
        log.append({"step":step,"loss":ls,"lr":lr,"elapsed_s":round(el,2),"s_per_step":round(sps,3)})
        with open(lp,'a') as f: f.write(json.dumps(log[-1])+'\n')
        if step%2==0 or step==NUM_STEPS-1:
            remain=(NUM_STEPS-1-step)*sps; eta=f"{remain/60:.1f}min" if remain>=60 else f"{remain:.0f}s"
            print(f"{step:>4} {ls:>10.5f} {lr:.2e} {sps:>7.3f} {eta:>8}",flush=True)
        now=time.time()
        if now-_lt>=30 or step==NUM_STEPS-1:
            _lt=now; remain=(NUM_STEPS-1-step)*sps if sps>0 else 0
            eta=f"{remain/60:.1f}min" if remain>=60 else f"{remain:.0f}s"
            try: subprocess.run([sys.executable,os.path.join(WS_DIR,"timing_table.py"),"--doing","7",str(round(el,0)),f"{step+1}/{NUM_STEPS}步 ETA{eta} loss={ls:.3f}"],check=False)
            except Exception: pass
    torch.save(dit.state_dict(), os.path.join(OUT,"dit_cpt_state.pt"))
    f5=sum(r['loss'] for r in log[:5])/min(5,len(log)); l5=sum(r['loss'] for r in log[-5:])/min(5,len(log))
    s={"paradigm":"diffusion_flow_matching","parallel":"single","steps":NUM_STEPS,"lr":LR,"warmup":WARMUP,
       "optim":"NpuFusedAdamW","precision":"fp32+bf16 autocast","grad_ckpt":True,"n_params_B":round(nP/1e9,4),
       "first5":round(f5,5),"last5":round(l5,5),"min":round(min(r['loss'] for r in log),5),
       "final":round(log[-1]['loss'],5),"delta":round(f5-l5,5),"total_time_s":round(time.time()-t0,2)}
    json.dump(s,open(os.path.join(OUT,'train_summary.json'),'w'),ensure_ascii=False,indent=2)
    json.dump(log,open(os.path.join(OUT,'losses.json'),'w'),ensure_ascii=False,indent=2)
    print("\n[done]"+json.dumps(s,ensure_ascii=False,indent=2),flush=True)

if __name__=="__main__": main()
