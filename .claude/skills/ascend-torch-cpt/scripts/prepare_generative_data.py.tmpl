#!/usr/bin/env python
# prepare_generative_data.py.tmpl — 扩散生成式(文生视频/文生图) CPT 数据预处理
# 解码(视频decord/图片PIL) → VAE编码(NPU) → 文本编码(可选) → 缓存 latent+emb
# 规避 cgroup(#44/#46): VAE/UMT5 加载与编码全在 NPU；CPU 仅解码(帧小)。
# 占位: MODEL_DIR, DATA_FILE, WS_DIR 由 run_env.sh 注入；N_FRAMES/VID_H/VID_W/MAX_LEN 可 env 覆盖
import os, json, glob, time
os.environ.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD","0")
os.environ.setdefault("TASK_QUEUE_ENABLE","1")
os.environ.setdefault("PYTORCH_NPU_ALLOC_CONF","expandable_segments:True")
import torch, torch_npu
torch.npu.set_device(0); DEV="npu:0"
# 依赖: pip install diffusers decord imageio-ffmpeg (decord 自带 ffmpeg)
try:
    import decord  # 视频
except Exception:
    decord=None
from PIL import Image  # 图片
import numpy as np

MODEL_DIR=os.environ["MODEL_DIR"]; WS_DIR=os.environ["WS_DIR"]
N_FRAMES=int(os.environ.get("N_FRAMES","21"))   # 满足 VAE 时间压缩因子 k: (T-1)%k==0 (Wan k=4)
H=int(os.environ.get("VID_H","480")); W=int(os.environ.get("VID_W","832"))
MAX_LEN=int(os.environ.get("MAX_LEN","77"))
# backbone 子目录名: Wan=transformer, SD/CogVideoX 等=unet/transformer
BK_DIR=os.environ.get("BACKBONE_DIR","transformer")
VAE_DIR=os.environ.get("VAE_DIR","vae")
TE_DIR=os.environ.get("TEXT_ENCODER_DIR","text_encoder")

def load_vae():
    from diffusers import AutoencoderKLWan  # Wan; 其它模型用对应 VAE 类(见 generative-diffusion-cpt.md)
    vae=AutoencoderKLWan.from_pretrained(f"{MODEL_DIR}/{VAE_DIR}", torch_dtype=torch.bfloat16).to(DEV).eval()
    for p in vae.parameters(): p.requires_grad=False
    return vae

def vae_norm_tensors(vae):
    """Wan latent 归一化张量(#52): decode 反向是 raw=stored*std+mean, 故 stored=(raw-mean)/std(除)。
    AutoencoderKLWan.encode().latent_dist.sample() 返回 raw(无自动归一化)。无 latents_mean/std 返回 None。"""
    cfg=getattr(vae,"config",None)
    lm=getattr(cfg,"latents_mean",None); ls=getattr(cfg,"latents_std",None)
    if lm is None or ls is None: return None,None
    z=getattr(cfg,"z_dim",getattr(cfg,"latents","16") if isinstance(getattr(cfg,"latents",None),int) else 16)
    import torch as _t
    mean=_t.tensor(lm,device=DEV).view(1,z,1,1,1).to(torch.bfloat16)
    std=_t.tensor(ls,device=DEV).view(1,z,1,1,1).to(torch.bfloat16)
    return mean,std

def load_text_encoder():
    """可选: TE 分片不全则返回 (None,None) → 零嵌入兜底(#50)。"""
    shards=glob.glob(f"{MODEL_DIR}/{TE_DIR}/model-*.safetensors")
    if len(shards)<1:
        print(f"[text] TE 无分片，零嵌入近似无条件(#50)", flush=True); return None,None
    try:
        import transformers
        tok=transformers.AutoTokenizer.from_pretrained(f"{MODEL_DIR}/tokenizer")
        # UMT5 必须用 UMT5EncoderModel(每层有 relative_attention_bias); 用 T5EncoderModel 会丢 block1-23 的偏置(#53)。CLIP 用 CLIPTextModel。
        te_cls=transformers.UMT5EncoderModel
        te=te_cls.from_pretrained(f"{MODEL_DIR}/{TE_DIR}", torch_dtype=torch.bfloat16).to(DEV).eval()
        for p in te.parameters(): p.requires_grad=False
        print("[text] TE 已加载(UMT5EncoderModel)，真实 caption 编码", flush=True); return tok,te
    except Exception as e:
        print(f"[text] TE 加载失败({type(e).__name__}: {str(e)[:120]})，零嵌入(#50)", flush=True); return None,None

def decode_video(path):
    """视频 → [T,3,H,W] float [-1,1]。decord 优先; 装不上回退 imageio.v3(自带 ffmpeg, #P2-2)。layout 修正见 #49。"""
    if decord is not None:
        vr=decord.VideoReader(path, width=W, height=H); n=len(vr)
        idx=list(range(0, n, max(1,n//N_FRAMES)))[:N_FRAMES]
        while len(idx)<N_FRAMES: idx.append(idx[-1] if idx else 0)
        fr=vr.get_batch(idx).asnumpy()  # [T,H,W,3] uint8
        return torch.from_numpy(fr).float().permute(0,3,1,2)/127.5-1.0  # [T,3,H,W]
    import imageio.v3 as iio  # 回退: 读全帧再抽帧(decord 无 wheel / 缺 ffmpeg 时)
    fr=iio.imread(path, index=None)  # [T,H,W,3] uint8
    fr=np.asarray(fr); T=fr.shape[0]
    idx=np.linspace(0,T-1,N_FRAMES).astype(int) if T>=N_FRAMES else np.minimum(np.arange(N_FRAMES),T-1)
    fr=fr[idx]
    return torch.from_numpy(fr).float().permute(0,3,1,2)/127.5-1.0

def decode_image(path):
    """PIL → [3,H,W] float [-1,1]。"""
    im=Image.open(path).convert("RGB").resize((W,H))
    return torch.from_numpy(np.array(im)).float().permute(2,0,1)/127.5-1.0  # [3,H,W]

def encode_vae(vae, vid, mean=None, std=None):
    """VAE 编码 [T,3,H,W] → latent [1,C,Tl,Hl,Wl]。输入 [B,C,T,H,W](#49)。
    归一化(#52, 默认 LATENT_NORM=1): stored=(raw-mean)/std(除), 匹配预训练DiT+原pipeline; =0 则存 raw(原950PR方式)。"""
    v=vid.permute(1,0,2,3).unsqueeze(0).to(DEV, dtype=torch.bfloat16) if vid.dim()==4 else vid.unsqueeze(0).to(DEV,dtype=torch.bfloat16)
    with torch.no_grad():
        out=vae.encode(v)
        if hasattr(out,"latent_dist"): lat=out.latent_dist.sample()
        elif hasattr(out,"latents"): lat=out.latents
        else: lat=out
        if mean is not None and std is not None and os.environ.get("LATENT_NORM","1")!="0":
            lat=(lat-mean)/std  # 除(非乘); 见 pitfalls #52
    return lat

def caption_for(item, fn):
    """有 cap 用 cap; 无则从文件名派生(#P2-1): mixkit-airplane-arriving-at-air-terminal-4095_clip_1.mp4 → "airplane arriving at air terminal"。"""
    cap=item.get("cap") or item.get("caption") or item.get("text")
    if cap: return cap
    import re
    b=os.path.splitext(fn)[0].replace("_clip_1","")
    parts=[p for p in b.split("-") if p.lower()!="mixkit" and not re.fullmatch(r"\d+",p)]
    return " ".join(parts) or item.get("category","")

def encode_text(tok, te, cap):
    ids=tok(cap, max_length=MAX_LEN, padding="max_length", truncation=True, return_tensors="pt").input_ids.to(DEV)
    with torch.no_grad(): return te(input_ids=ids).last_hidden_state  # [1,L,D]

def main():
    vae=load_vae(); tok,te=load_text_encoder(); use_text=te is not None
    mean,std=vae_norm_tensors(vae)  # #52 latent 归一化(None=VAE无mean/std配置, 存raw)
    print(f"[init] VAE on {DEV}; text_encoder={'ON(UMT5)' if use_text else 'OFF(零嵌入,#50)'}; latent_norm={'ON(/std)' if mean is not None else 'OFF(无mean/std)'}", flush=True)
    # DATA_FILE: 视频用 jsonl/video2caption.json(每条{path,cap}) 或目录; 图片同理
    items=__import__("json").load(open(os.environ["DATA_FILE"]))
    if isinstance(items,dict): items=items.get("data",items.get("train",[]))
    vdir=os.environ.get("VIDEO_DIR", os.path.dirname(os.environ["DATA_FILE"]))
    latents=[]; embs=[]; caps=[]; t0=time.time()
    for i,item in enumerate(items):
        p=item.get("path",item.get("file","")); fn=os.path.basename(p)
        vp=os.path.join(vdir, fn) if not os.path.isabs(p) else p
        if not os.path.exists(vp): print(f"[skip] {fn}",flush=True); continue
        try:
            is_vid=fn.lower().endswith((".mp4",".avi",".mov",".mkv",".webm"))
            vid=decode_video(vp) if is_vid else decode_image(vp).unsqueeze(0)
            lat=encode_vae(vae, vid, mean, std)
            cap=caption_for(item, fn)  # 无标注则文件名派生(#P2-1)
            emb=encode_text(tok,te,cap) if use_text else torch.zeros(1,MAX_LEN,lat.shape[1] if lat.dim()>3 else 4096, dtype=torch.bfloat16)
            latents.append(lat.cpu()); embs.append(emb.cpu() if use_text else torch.zeros(1,MAX_LEN,4096,dtype=torch.bfloat16)); caps.append(cap[:60])
            if (i+1)%4==0: print(f"[encode] {i+1}/{len(items)} lat={tuple(lat.shape)} cap='{cap[:30]}' {time.time()-t0:.0f}s",flush=True)
        except Exception as e:
            print(f"[FAIL] {fn}: {type(e).__name__} {str(e)[:120]}",flush=True)
    torch.save({"latents":latents,"embs":embs,"captions":caps,"latent_norm": (mean is not None and os.environ.get("LATENT_NORM","1")!="0")}, f"{WS_DIR}/outputs/video_latents.pt")
    print(f"[done] cached {len(latents)} samples (latent_norm={'ON' if (mean is not None and os.environ.get('LATENT_NORM','1')!='0') else 'OFF/raw'}) {time.time()-t0:.0f}s",flush=True)

if __name__=="__main__": main()
