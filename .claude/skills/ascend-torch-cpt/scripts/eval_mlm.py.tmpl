#!/usr/bin/env python
# -*- coding: utf-8 -*-
# eval_mlm.py.tmpl — Encoder MLM 模型 base vs CPT 域内评估
# 指标: MLM loss / PPL / masked token accuracy
# held-out: VAL_FILE 独立验证集(优先) 或从 DATA_FILE held-out split
# 踩坑已规避: fp32 模型 + autocast(bf16), NLL 取负(#5), NaN 样本排除, eos_token_id fallback(#108)
import os, json, random, math, torch, torch_npu  # noqa: F401
from transformers import AutoModelForMaskedLM, AutoTokenizer
from transformers.data.data_collator import DataCollatorForLanguageModeling

MODEL_DIR=os.environ["MODEL_DIR"]; DATA_FILE=os.environ["DATA_FILE"]; WS_DIR=os.environ["WS_DIR"]
OUT=os.path.join(WS_DIR,"outputs"); CKPT=os.path.join(OUT,"cpt_model_state.pt")
DEVICE="npu:0"; SEED=int(os.environ.get("SEED","42")); N_VAL=int(os.environ.get("N_VAL","10"))
VAL_FILE=os.environ.get("VAL_FILE","")
TRAIN_RATIO=float(os.environ.get("RATIO","1.0"))

def load_model(src):
    model=AutoModelForMaskedLM.from_pretrained(MODEL_DIR, torch_dtype=torch.float32, trust_remote_code=True)
    if src=='cpt' and os.path.exists(CKPT):
        sd=torch.load(CKPT,map_location=DEVICE,weights_only=False)
        model.load_state_dict(sd,strict=False)
    model=model.to(DEVICE); model.eval()
    return model

def main():
    torch.npu.set_device(0)
    tok=AutoTokenizer.from_pretrained(MODEL_DIR, trust_remote_code=True)
    if tok.pad_token is None:
        tok.pad_token=tok.eos_token or tok.unk_token or tok.sep_token or '[PAD]'
    collator=DataCollatorForLanguageModeling(tokenizer=tok,mlm=True,mlm_probability=0.15)
    if VAL_FILE and os.path.exists(VAL_FILE):
        val=[json.loads(l) for l in open(VAL_FILE,encoding='utf-8') if l.strip()][:N_VAL]
        print(f"[val] VAL_FILE 取 {len(val)} 条(独立验证集)",flush=True)
    else:
        recs=[json.loads(l) for l in open(DATA_FILE,encoding='utf-8') if l.strip()]
        total=len(recs); n_tr=int(total*TRAIN_RATIO)
        rng=random.Random(SEED); idx=list(range(total)); rng.shuffle(idx)
        held=idx[n_tr:]; val=[recs[i] for i in held[:N_VAL]]
        print(f"[val] held_out={len(held)} 取 {len(val)} 条",flush=True)
    json.dump(val,open(os.path.join(OUT,'val_samples.json'),'w'),ensure_ascii=False,indent=2)
    res={"base":[],"cpt":[]}; summ={}
    for tag in ["base","cpt"]:
        print(f"\n===== eval {tag} =====",flush=True)
        m=load_model(tag)
        tot_loss=tot_acc=tot_n=0
        for i,rec in enumerate(val):
            text=rec.get('text','')
            if not text: continue
            ids=tok(text,truncation=True,max_length=512,add_special_tokens=True)['input_ids']
            batch=collator([ids])
            inp=batch['input_ids'].to(DEVICE)
            attn=batch.get('attention_mask',torch.ones_like(inp)).to(DEVICE)
            lbl=batch['labels'].to(DEVICE)
            with torch.no_grad(),torch.autocast(device_type="npu",dtype=torch.bfloat16):
                out=m(input_ids=inp,attention_mask=attn,labels=lbl)
            ls=float(out.loss)
            mask=lbl!=-100
            acc=float((out.logits[mask].float().argmax(-1)==lbl[mask]).float().mean().cpu()) if mask.any() else 0.0
            if not math.isnan(ls): tot_loss+=ls; tot_acc+=acc; tot_n+=1
            res[tag].append({"i":i,"loss":ls,"ppl":math.exp(min(ls,20)) if not math.isnan(ls) else float('nan'),"acc":acc})
            print(f"  [{tag}] v{i}: loss={ls:.4f} ppl={math.exp(min(ls,20)) if not math.isnan(ls) else 'NaN':.2f} acc={acc:.3f}",flush=True)
        n=max(1,tot_n)
        ml=tot_loss/n
        summ[tag]={"mean_loss":round(ml,5),"mean_ppl":round(math.exp(min(ml,20)),2),"mean_acc":round(tot_acc/n,5),"n_valid":tot_n}
        del m; torch.npu.empty_cache()
    b,c=summ["base"],summ["cpt"]
    delta={k:round(c[k]-b[k],5) for k in b if k!='n_valid'}
    fin={"base":b,"cpt":c,"delta_cpt_minus_base":delta,"note":"loss/ppl delta<0 改善; acc delta>0 改善; NaN样本已排除"}
    json.dump({"summary":fin,"per_sample":res},open(os.path.join(OUT,'eval_results.json'),'w'),ensure_ascii=False,indent=2)
    print("\n===== 汇总 =====\n"+json.dumps(fin,ensure_ascii=False,indent=2),flush=True)

if __name__=='__main__': main()
